diff --git a/route/kabanmax_auto.go b/route/kabanmax_auto.go
new file mode 100755
index 0000000..0c8fa3f
--- /dev/null
+++ b/route/kabanmax_auto.go
@@ -0,0 +1,150 @@
+package route
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	R "github.com/sagernet/sing-box/route/rule"
+	"github.com/sagernet/sing/common/buf"
+	N "github.com/sagernet/sing/common/network"
+	"net/netip"
+	"strings"
+	"time"
+)
+
+func (r *Router) initKabanmaxAuto() {
+	r.autoInit.Do(func() {
+		m := r.autoRouting
+		if m == nil {
+			return
+		}
+		m.Outbound = r.outbound.Outbound
+		m.Match = func(ctx context.Context, metadata *adapter.InboundContext) (string, error) {
+			selected, selectedIndex, buffers, packets, e := r.matchRule(ctx, metadata, nil, nil)
+			buf.ReleaseMulti(buffers)
+			N.ReleaseMultiPacketBuffer(packets)
+			if e != nil {
+				return "", e
+			}
+			count := selectedIndex + 1
+			if selected == nil {
+				count = len(r.ruleOptions)
+			}
+			for i := 0; i < count; i++ {
+				if i >= len(r.ruleOptions) || !r.probeContextKnown(r.ruleOptions[i], metadata.Source.Port, 0) {
+					return "", errors.New("probe_scope_requires_connection_metadata")
+				}
+			}
+			if selected == nil {
+				return r.defaultOutbound.Tag(), nil
+			}
+			if action, ok := selected.Action().(*R.RuleActionRoute); ok {
+				return action.Outbound, nil
+			}
+			return "", errors.New("first_match_not_routable")
+		}
+		m.Lookup = func(ctx context.Context, name string) ([]netip.Addr, uint32, error) {
+			ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
+			defer cancel()
+			var transport adapter.DNSTransport
+			if t, ok := r.dnsTransport.Transport("dns-server"); ok {
+				transport = t
+			} else {
+				return nil, 0, errors.New("main_dns_unavailable")
+			}
+			addresses := []netip.Addr{}
+			ttl := uint32(900)
+			for _, qtype := range []uint16{dns.TypeA, dns.TypeAAAA} {
+				query := new(dns.Msg)
+				query.SetQuestion(dns.Fqdn(name), qtype)
+				reply, e := r.dns.Exchange(ctx, query, adapter.DNSQueryOptions{Transport: transport, DisableCache: true, DisableOptimisticCache: true})
+				if e != nil || reply == nil || reply.Rcode != dns.RcodeSuccess {
+					return nil, 0, errors.New("dns_unconfirmed")
+				}
+				for _, rr := range reply.Answer {
+					if (rr.Header().Rrtype == dns.TypeA || rr.Header().Rrtype == dns.TypeAAAA) && (!strings.EqualFold(dns.Fqdn(rr.Header().Name), dns.Fqdn(name)) || rr.Header().Rrtype != qtype || rr.Header().Class != dns.ClassINET) {
+						return nil, 0, errors.New("dns_answer_identity_unconfirmed")
+					}
+					if rr.Header().Ttl < ttl {
+						ttl = rr.Header().Ttl
+					}
+					switch v := rr.(type) {
+					case *dns.A:
+						a, ok := netip.AddrFromSlice(v.A)
+						if ok {
+							addresses = append(addresses, a.Unmap())
+						}
+					case *dns.AAAA:
+						a, ok := netip.AddrFromSlice(v.AAAA)
+						if ok {
+							addresses = append(addresses, a.Unmap())
+						}
+					case *dns.CNAME:
+						return nil, 0, errors.New("cname_chain_requires_identity_evidence")
+					}
+				}
+			}
+			return addresses, ttl, nil
+		}
+		m.Start(r.ctx)
+	})
+}
+
+// The actual core matcher chooses the first rule. This check only refuses
+// negative matches whose missing process/client metadata could hide an earlier
+// rule; it never reconstructs a positive routing decision in another engine.
+func (r *Router) probeContextKnown(spec option.Rule, sourcePort uint16, depth int) bool {
+	if depth > 8 {
+		return false
+	}
+	if spec.Type == "logical" {
+		for _, child := range spec.LogicalOptions.Rules {
+			if !r.probeContextKnown(child, sourcePort, depth+1) {
+				return false
+			}
+		}
+		return true
+	}
+	raw, e := json.Marshal(spec.DefaultOptions.RawDefaultRule)
+	if e != nil {
+		return false
+	}
+	var fields map[string]json.RawMessage
+	if json.Unmarshal(raw, &fields) != nil {
+		return false
+	}
+	for key := range fields {
+		switch key {
+		case "inbound", "ip_version", "network", "protocol", "domain", "domain_suffix", "domain_keyword", "domain_regex", "source_geoip", "geoip", "geosite", "source_ip_cidr", "source_ip_is_private", "ip_cidr", "ip_is_private", "port", "port_range", "rule_set_ip_cidr_match_source", "rule_set_ipcidr_match_source", "invert":
+		case "source_port", "source_port_range":
+			if sourcePort == 0 {
+				return false
+			}
+		case "rule_set":
+			for _, tag := range spec.DefaultOptions.RuleSet {
+				set, ok := r.ruleSetMap[tag]
+				if !ok {
+					return false
+				}
+				md := set.Metadata()
+				if md.ContainsProcessRule || md.ContainsWIFIRule || (sourcePort == 0 && md.ContainsNonIPCIDRRule) {
+					return false
+				}
+			}
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func (r *Router) KabanmaxAuto(ctx context.Context, request []byte) (any, error) {
+	if r.autoRouting == nil {
+		return nil, errors.New("automatic_routing_unavailable")
+	}
+	r.initKabanmaxAuto()
+	return r.autoRouting.API(ctx, request)
+}
