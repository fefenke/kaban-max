@@ -0,0 +1,40 @@
+package clashapi
+
+import (
+	"context"
+	"github.com/go-chi/render"
+	"io"
+	"net/http"
+)
+
+func kabanmaxAuto(s *Server, write bool) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if write && !s.autoWriteAuthorized {
+			http.Error(w, "automatic routing requires API authentication", http.StatusForbidden)
+			return
+		}
+		api, ok := s.router.(interface {
+			KabanmaxAuto(context.Context, []byte) (any, error)
+		})
+		if !ok {
+			http.Error(w, "not supported", http.StatusNotImplemented)
+			return
+		}
+		body := []byte(`{"op":"state"}`)
+		if write {
+			var e error
+			body, e = io.ReadAll(http.MaxBytesReader(w, r.Body, 8192))
+			if e != nil {
+				http.Error(w, "request too large", http.StatusRequestEntityTooLarge)
+				return
+			}
+		}
+		answer, e := api.KabanmaxAuto(r.Context(), body)
+		if e != nil {
+			render.Status(r, http.StatusConflict)
+			render.JSON(w, r, map[string]any{"success": false, "reason": e.Error()})
+			return
+		}
+		render.JSON(w, r, answer)
+	}
+}
