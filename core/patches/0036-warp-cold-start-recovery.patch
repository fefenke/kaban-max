+// Only the first, never-established session gets a bounded burst of new paths.
+// After three rotations, retain the normal backoff even while the network is down.
+func (device *Device) coldStartPending(peer *Peer) bool {
+	return device.giveUpRebind.coldStart.Load() && device.giveUpRebind.freshPort.Load() && device.giveUpRebind.coldRebinds.Load() < 3 && peer.lastHandshakeNano.Load() == 0 && peer.keypairs.Current() == nil
+}
