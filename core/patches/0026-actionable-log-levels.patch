diff --git a/route/connection_log.go b/route/connection_log.go
new file mode 100644
--- /dev/null
+++ b/route/connection_log.go
@@ -0,0 +1,29 @@
+package route
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"syscall"
+)
+
+// These per-flow transport failures do not identify a configuration fix. Keep
+// their original cause for diagnostics and routing evidence, but below Warn.
+func (m *ConnectionManager) logConnectionFailure(ctx context.Context, err error) {
+	routine := errors.Is(err, context.Canceled) || errors.Is(err, net.ErrClosed) || errors.Is(err, io.EOF)
+	for _, cause := range []error{syscall.EHOSTUNREACH, syscall.ENETUNREACH, syscall.ENOTCONN, syscall.ECONNRESET, syscall.ECONNABORTED, syscall.EPIPE} {
+		routine = routine || errors.Is(err, cause)
+	}
+	// Userspace network stacks do not always wrap a syscall.Errno.
+	detail := err.Error()
+	for _, text := range []string{"no route to host", "network is unreachable", "endpoint not connected", "connection reset by peer", "broken pipe"} {
+		routine = routine || detail == text || strings.HasSuffix(detail, ": "+text)
+	}
+	if routine {
+		m.logger.DebugContext(ctx, err)
+	} else {
+		m.logger.ErrorContext(ctx, err)
+	}
+}
