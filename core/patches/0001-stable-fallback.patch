diff --git a/cmd/sing-box/stable_observation_fingerprint.go b/cmd/sing-box/stable_observation_fingerprint.go
new file mode 100644
index 0000000..bb51be5
--- /dev/null
+++ b/cmd/sing-box/stable_observation_fingerprint.go
@@ -0,0 +1,120 @@
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+// Fingerprints contain connection and group configuration only. They never
+// include routing lists, and only the digest leaves this function.
+func stableObservationFingerprints(raw []byte) map[string]string {
+	result := make(map[string]string)
+	if len(raw) == 0 {
+		return result
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	var root map[string]any
+	if decoder.Decode(&root) != nil {
+		return result
+	}
+	sections := make(map[string]map[string]map[string]any)
+	for _, section := range []string{"outbounds", "providers", "endpoints"} {
+		sections[section] = make(map[string]map[string]any)
+		entries, _ := root[section].([]any)
+		for _, entry := range entries {
+			object, ok := entry.(map[string]any)
+			if !ok {
+				return result
+			}
+			tag, _ := object["tag"].(string)
+			if tag == "" {
+				continue
+			}
+			if _, duplicate := sections[section][tag]; duplicate {
+				return map[string]string{}
+			}
+			sections[section][tag] = object
+		}
+	}
+	for tag, object := range sections["outbounds"] {
+		if object["type"] != "fallback" || object["stable"] != true {
+			continue
+		}
+		graph := make(map[string]any)
+		valid := true
+		var add func(string, string)
+		var scan func(any)
+		add = func(section, tag string) {
+			if tag == "" {
+				return
+			}
+			key := section + "/" + tag
+			if _, seen := graph[key]; seen {
+				return
+			}
+			object, ok := sections[section][tag]
+			if !ok && section == "outbounds" {
+				section = "endpoints"
+				key = section + "/" + tag
+				object, ok = sections[section][tag]
+			}
+			if !ok {
+				valid = false
+				return
+			}
+			if _, seen := graph[key]; seen {
+				return
+			}
+			graph[key] = object
+			scan(object)
+		}
+		scan = func(value any) {
+			switch value := value.(type) {
+			case map[string]any:
+				for key, nested := range value {
+					switch key {
+					case "detour", "download_detour":
+						if name, ok := nested.(string); ok {
+							add("outbounds", name)
+						}
+					case "outbounds", "providers", "endpoints":
+						if names, ok := nested.([]any); ok {
+							for _, name := range names {
+								if tag, ok := name.(string); ok {
+									add(key, tag)
+								}
+							}
+						} else if name, ok := nested.(string); ok {
+							add(key, name)
+						}
+					case "use_all_providers":
+						if nested == true {
+							for name := range sections["providers"] {
+								add("providers", name)
+							}
+						}
+					}
+					scan(nested)
+				}
+			case []any:
+				for _, nested := range value {
+					scan(nested)
+				}
+			}
+		}
+		add("outbounds", tag)
+		if !valid {
+			continue
+		}
+		canonical, err := json.Marshal(graph)
+		if err != nil {
+			continue
+		}
+		digest := sha256.Sum256(canonical)
+		result[tag] = hex.EncodeToString(digest[:])
+	}
+	return result
+}
diff --git a/cmd/sing-box/stable_observation_fingerprint_test.go b/cmd/sing-box/stable_observation_fingerprint_test.go
new file mode 100644
index 0000000..87693da
--- /dev/null
+++ b/cmd/sing-box/stable_observation_fingerprint_test.go
@@ -0,0 +1,58 @@
+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+const stableFingerprintBase = `{"outbounds":[{"tag":"g","type":"fallback","stable":true,"outbounds":["a"]},{"tag":"a","type":"parser","link":"vless://secret","tls_classical":true,"detour":"d"},{"tag":"d","type":"direct"}],"route":{"rules":[{"domain":["a.example"]}]}}`
+
+func mutateStableFingerprint(t *testing.T, fn func(map[string]any)) []byte {
+	t.Helper()
+	var raw map[string]any
+	if err := json.Unmarshal([]byte(stableFingerprintBase), &raw); err != nil {
+		t.Fatal(err)
+	}
+	fn(raw)
+	data, err := json.Marshal(raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+func TestStableFingerprintIgnoresRoutingButTracksConnectionGraph(t *testing.T) {
+	original := stableObservationFingerprints([]byte(stableFingerprintBase))["g"]
+	if original == "" {
+		t.Fatal("missing fingerprint")
+	}
+	routing := mutateStableFingerprint(t, func(raw map[string]any) { raw["route"] = map[string]any{"rules": []any{"changed"}} })
+	if stableObservationFingerprints(routing)["g"] != original {
+		t.Fatal("routing edit reset observations")
+	}
+	for _, change := range []func(map[string]any){
+		func(raw map[string]any) { raw["outbounds"].([]any)[1].(map[string]any)["tls_classical"] = false },
+		func(raw map[string]any) { raw["outbounds"].([]any)[0].(map[string]any)["recovery_successes"] = 4 },
+		func(raw map[string]any) { raw["outbounds"].([]any)[2].(map[string]any)["bind_interface"] = "changed" },
+	} {
+		if stableObservationFingerprints(mutateStableFingerprint(t, change))["g"] == original {
+			t.Fatal("connection or fallback edit reused observations")
+		}
+	}
+	if len(stableObservationFingerprints(nil)) != 0 || len(stableObservationFingerprints([]byte("broken"))) != 0 {
+		t.Fatal("missing raw config restored observations")
+	}
+}
+func TestStableFingerprintFollowsProvidersAndEndpoints(t *testing.T) {
+	raw := []byte(`{"outbounds":[{"tag":"g","type":"fallback","stable":true,"providers":["p"]}],"providers":[{"tag":"p","type":"inline","outbounds":[{"tag":"a","type":"parser","link":"secret","detour":"e"}]}],"endpoints":[{"tag":"e","type":"wireguard","private_key":"secret"}]}`)
+	first := stableObservationFingerprints(raw)["g"]
+	if first == "" {
+		t.Fatal("provider graph missing")
+	}
+	var data map[string]any
+	json.Unmarshal(raw, &data)
+	data["endpoints"].([]any)[0].(map[string]any)["private_key"] = "changed"
+	changed, _ := json.Marshal(data)
+	if stableObservationFingerprints(changed)["g"] == first {
+		t.Fatal("endpoint change reused observations")
+	}
+}
diff --git a/cmd/sing-box/stable_observation_reload.go b/cmd/sing-box/stable_observation_reload.go
new file mode 100644
index 0000000..492b461
--- /dev/null
+++ b/cmd/sing-box/stable_observation_reload.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/group"
+)
+
+type stableReloadObservation struct {
+	fingerprint string
+	snapshot    *group.StableFallbackObservationSnapshot
+}
+
+// The run loop owns this map for one reload generation; it is neither global
+// nor persisted. Every reload replaces it with at most 128 current groups.
+type stableReloadObservations map[string]stableReloadObservation
+
+func captureStableReloadObservations(instance *box.Box, options option.Options) stableReloadObservations {
+	snapshots := make(stableReloadObservations)
+	fingerprints := stableObservationFingerprints(options.RawMessage)
+	for _, outbound := range instance.Outbound().Outbounds() {
+		stable, ok := outbound.(*group.Fallback)
+		if !ok {
+			continue
+		}
+		key, ok := fingerprints[outbound.Tag()]
+		if !ok {
+			continue
+		}
+		snapshot := stable.ExportStableObservation()
+		if snapshot == nil {
+			continue
+		}
+		snapshots[outbound.Tag()] = stableReloadObservation{fingerprint: key, snapshot: snapshot}
+		if len(snapshots) == 128 {
+			break
+		}
+	}
+	return snapshots
+}
+func restoreStableReloadObservations(instance *box.Box, options option.Options, snapshots stableReloadObservations) {
+	if len(snapshots) == 0 {
+		return
+	}
+	fingerprints := stableObservationFingerprints(options.RawMessage)
+	for _, outbound := range instance.Outbound().Outbounds() {
+		stable, ok := outbound.(*group.Fallback)
+		if !ok {
+			continue
+		}
+		previous, ok := snapshots[outbound.Tag()]
+		if !ok || fingerprints[outbound.Tag()] != previous.fingerprint {
+			continue
+		}
+		stable.RestoreStableObservation(previous.snapshot)
+	}
+}
diff --git a/cmd/sing-box/stable_observation_reload_test.go b/cmd/sing-box/stable_observation_reload_test.go
