diff --git a/common/tlsfragment/client_hello_record.go b/common/tlsfragment/client_hello_record.go
new file mode 100644
index 0000000..b4f7656
--- /dev/null
+++ b/common/tlsfragment/client_hello_record.go
@@ -0,0 +1,56 @@
+package tf
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+)
+
+// ClientHelloRecordConn splits only the first ClientHello record into two
+// nearly equal payload records. The handshake transcript is unchanged.
+type ClientHelloRecordConn struct {
+	net.Conn
+	written bool
+}
+
+func NewClientHelloRecordConn(conn net.Conn) *ClientHelloRecordConn {
+	return &ClientHelloRecordConn{Conn: conn}
+}
+func (c *ClientHelloRecordConn) Write(p []byte) (int, error) {
+	if c.written || len(p) == 0 {
+		return c.Conn.Write(p)
+	}
+	c.written = true
+	if len(p) < 6 || p[0] != 22 || p[1] != 3 || p[5] != 1 {
+		return c.Conn.Write(p)
+	}
+	length := int(binary.BigEndian.Uint16(p[3:5]))
+	if length < 2 || length > len(p)-5 {
+		return c.Conn.Write(p)
+	}
+	first := length / 2
+	wire := make([]byte, 0, len(p)+5)
+	for _, bounds := range [][2]int{{0, first}, {first, length}} {
+		count := bounds[1] - bounds[0]
+		wire = append(wire, p[:3]...)
+		wire = append(wire, byte(count>>8), byte(count))
+		wire = append(wire, p[5+bounds[0]:5+bounds[1]]...)
+	}
+	wire = append(wire, p[5+length:]...)
+	n, err := c.Conn.Write(wire)
+	if n == len(wire) {
+		return len(p), err
+	}
+	// The inserted second record header consumes no original input bytes.
+	consumed := n
+	if n > 5+first {
+		consumed -= min(5, n-(5+first))
+	}
+	if err == nil {
+		err = io.ErrShortWrite
+	}
+	return consumed, err
+}
+func (c *ClientHelloRecordConn) ReaderReplaceable() bool { return true }
+func (c *ClientHelloRecordConn) WriterReplaceable() bool { return c.written }
+func (c *ClientHelloRecordConn) Upstream() any           { return c.Conn }
diff --git a/common/tlsfragment/client_hello_record_test.go b/common/tlsfragment/client_hello_record_test.go
new file mode 100644
index 0000000..270fad0
--- /dev/null
+++ b/common/tlsfragment/client_hello_record_test.go
@@ -0,0 +1,131 @@
+package tf
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"net"
+	"strconv"
+	"testing"
+)
+
+type recordCapture struct {
+	net.Conn
+	data   []byte
+	writes int
+	limit  int
+	err    error
+}
+
+func (c *recordCapture) Write(p []byte) (int, error) {
+	c.writes++
+	n := len(p)
+	if c.limit > 0 && n > c.limit {
+		n = c.limit
+	}
+	c.data = append(c.data, p[:n]...)
+	return n, c.err
+}
+func helloRecord(n int) []byte {
+	b := make([]byte, 5+n)
+	copy(b, []byte{22, 3, 1})
+	binary.BigEndian.PutUint16(b[3:], uint16(n))
+	for i := 5; i < len(b); i++ {
+		b[i] = byte(i)
+	}
+	b[5] = 1
+	return b
+}
+func TestClientHelloRecordFragments(t *testing.T) {
+	for _, size := range []int{2, 3, 512, 513, 1800} {
+		t.Run(strconv.Itoa(size), func(t *testing.T) {
+			raw := helloRecord(size)
+			tail := []byte{23, 3, 3, 0, 2, 7, 8}
+			input := append(append([]byte{}, raw...), tail...)
+			dst := &recordCapture{}
+			c := NewClientHelloRecordConn(dst)
+			n, err := c.Write(input)
+			if n != len(input) || err != nil || dst.writes != 1 {
+				t.Fatalf("write=%d,%v calls=%d", n, err, dst.writes)
+			}
+			wire := dst.data
+			var payload []byte
+			for _, want := range []int{size / 2, size - size/2} {
+				if len(wire) < 5 || !bytes.Equal(wire[:3], raw[:3]) {
+					t.Fatal("record header changed")
+				}
+				length := int(binary.BigEndian.Uint16(wire[3:]))
+				if length != want {
+					t.Fatalf("fragment length %d", length)
+				}
+				payload = append(payload, wire[5:5+length]...)
+				wire = wire[5+length:]
+			}
+			if !bytes.Equal(payload, raw[5:]) || !bytes.Equal(wire, tail) {
+				t.Fatal("payload or trailing record changed")
+			}
+			dst.data = nil
+			c.Write(raw)
+			if !bytes.Equal(dst.data, raw) {
+				t.Fatal("subsequent write fragmented")
+			}
+		})
+	}
+}
+func TestClientHelloRecordShortWrite(t *testing.T) {
+	raw := helloRecord(1400)
+	for _, limit := range []int{1, 5, 704, 705, 706, 709, 710, 711, 900, 1409} {
+		dst := &recordCapture{limit: limit}
+		n, err := NewClientHelloRecordConn(dst).Write(raw)
+		if err != io.ErrShortWrite || n < 0 || n >= len(raw) {
+			t.Fatalf("limit %d: %d,%v", limit, n, err)
+		}
+		want := limit
+		if limit > 705 {
+			want -= 5
+			if limit < 710 {
+				want = 705
+			}
+		}
+		if n != want {
+			t.Fatalf("limit %d: consumed %d want %d", limit, n, want)
+		}
+	}
+}
+func TestClientHelloRecordPassthrough(t *testing.T) {
+	for _, raw := range [][]byte{helloRecord(1), nil, {22, 3}, {23, 3, 3, 0, 1, 0}, {22, 3, 3, 0, 20, 1}, {22, 3, 3, 0, 1, 2}} {
+		dst := &recordCapture{}
+		c := NewClientHelloRecordConn(dst)
+		n, err := c.Write(raw)
+		if n != len(raw) || err != nil || !bytes.Equal(dst.data, raw) {
+			t.Fatal("passthrough changed")
+		}
+	}
+}
+
+func TestClientHelloRecordPropagatesTransportError(t *testing.T) {
+	raw := helloRecord(1400)
+	dst := &recordCapture{limit: 708, err: io.ErrClosedPipe}
+	n, err := NewClientHelloRecordConn(dst).Write(raw)
+	if n != 705 || err != io.ErrClosedPipe {
+		t.Fatalf("write=%d,%v", n, err)
+	}
+}
+func TestClientHelloRecordEmptyWriteDoesNotConsumeFirstRecord(t *testing.T) {
+	dst := &recordCapture{}
+	c := NewClientHelloRecordConn(dst)
+	c.Write(nil)
+	c.Write(helloRecord(1400))
+	if len(dst.data) != 1410 {
+		t.Fatalf("wire length %d", len(dst.data))
+	}
+}
+
+func TestClientHelloRecordShortWriteInTrailingRecord(t *testing.T) {
+	raw := append(helloRecord(5), []byte{23, 3, 3, 0, 2, 7, 8}...)
+	dst := &recordCapture{limit: 18}
+	n, err := NewClientHelloRecordConn(dst).Write(raw)
+	if n != 13 || err != io.ErrShortWrite || dst.writes != 1 {
+		t.Fatalf("write=%d,%v calls=%d", n, err, dst.writes)
+	}
+}
