+// ProbeTarget freezes the selected leaf for a measurement, matching MemberTag.
+func ProbeTarget(detour N.Dialer) N.Dialer {
+	for depth := 0; depth < 32; depth++ {
+		group, isGroup := detour.(adapter.OutboundGroup)
+		if !isGroup {
+			break
+		}
+		selected := group.Selected(N.NetworkTCP)
+		if selected == nil {
+			break
+		}
+		detour = selected
+	}
+	return detour
+}
+
+func SameProbeTarget(detour, captured N.Dialer) bool {
+	current := ProbeTarget(detour)
+	kind := reflect.TypeOf(current)
+	return kind == reflect.TypeOf(captured) && (kind == nil || kind.Comparable()) && current == captured
+}
