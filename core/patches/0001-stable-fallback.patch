@@ -0,0 +1,249 @@
+package group
+
+import (
+	"context"
+	"fmt"
+	"github.com/sagernet/sing-box/common/urltest"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestStableFallbackReachesReserveAfterSlowFailures(t *testing.T) {
+	good := newFallbackHealthTestOutbound("last", true)
+	s := stableTestGroup(t, good)
+	candidates := []fallbackCandidate{}
+	for i := 0; i < 3; i++ {
+		n := &fallbackBlockingOutbound{Adapter: newFallbackHealthTestOutbound(fmt.Sprint("slow", i), false).Adapter, started: make(chan struct{})}
+		candidates = append(candidates, fallbackCandidate{tag: n.Tag(), outbound: n})
+	}
+	candidates = append(candidates, fallbackCandidate{tag: good.Tag(), outbound: good})
+	s = newTestFallback(candidates...)
+	template := stableTestGroup(t, good)
+	s.stable = template.stable
+	s.expectedStatus = template.expectedStatus
+	s.timeout = 80 * time.Millisecond
+	s.stable.roundBudget = 240 * time.Millisecond
+	confirmStableFailure(s)
+	if selectedTag(s) != "last" {
+		t.Fatalf("healthy later reserve starved: selected=%s", selectedTag(s))
+	}
+}
+
+func stableTestGroup(t *testing.T, nodes ...*fallbackHealthTestOutbound) *Fallback {
+	t.Helper()
+	candidates := make([]fallbackCandidate, len(nodes))
+	for i, n := range nodes {
+		candidates[i] = fallbackCandidate{tag: n.Tag(), outbound: n}
+	}
+	s := newTestFallback(candidates...)
+	expected, err := urltest.ParseExpectedStatus("204")
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.expectedStatus = expected
+	s.stable = &stableFallback{confirmURL: "http://confirm.test/", confirmStatus: expected, recoveryInterval: time.Minute, returnAfter: 3}
+	return s
+}
+
+func TestStableFallbackKeepsReserveQuiet(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", true), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	for range 4 {
+		s.checkOutbounds(context.Background(), 0)
+	}
+	if b.dialCount != 0 || selectedTag(s) != "primary" {
+		t.Fatalf("reserve was touched: %d, selected=%s", b.dialCount, selectedTag(s))
+	}
+	if a.dialCount != 4 {
+		t.Fatalf("primary checks=%d", a.dialCount)
+	}
+}
+
+func TestStableFallbackSequentialFailoverAndRecovery(t *testing.T) {
+	a, b, c := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true), newFallbackHealthTestOutbound("third", true)
+	s := stableTestGroup(t, a, b, c)
+	confirmStableFailure(s)
+	if selectedTag(s) != "backup" || a.dialCount != 4 || b.dialCount != 1 || c.dialCount != 0 {
+		t.Fatalf("wrong failover: %s checks=%d/%d/%d", selectedTag(s), a.dialCount, b.dialCount, c.dialCount)
+	}
+	a.setAvailable(true)
+	s.checkOutbounds(context.Background(), 0)
+	if a.dialCount != 4 {
+		t.Fatal("recovery interval ignored")
+	}
+	for i := 1; i <= 3; i++ {
+		s.stable.lastRecovery = time.Now().Add(-2 * time.Minute)
+		s.checkOutbounds(context.Background(), 0)
+		want := "backup"
+		if i == 3 {
+			want = "primary"
+		}
+		if selectedTag(s) != want {
+			t.Fatalf("recovery %d selected %s, want %s", i, selectedTag(s), want)
+		}
+		if i < 3 && s.candidatesForNetwork("tcp")[0].tag != "backup" {
+			t.Fatal("real dials bypassed recovery hysteresis")
+		}
+	}
+	if c.dialCount != 0 {
+		t.Fatal("third reserve was probed")
+	}
+}
+
+func TestStableFallbackCancelledRoundPreservesState(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", true), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	s.checkOutbounds(ctx, 0)
+	if a.dialCount != 0 || b.dialCount != 0 || s.health["primary"].checked {
+		t.Fatal("cancelled round changed health")
+	}
+}
+
+func TestStableFallbackAllDownHasNoDirectEscape(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", false)
+	s := stableTestGroup(t, a, b)
+	confirmStableFailure(s)
+	status := s.StableStatus()
+	if status.State != "degraded" || status.Active != "primary" {
+		t.Fatalf("unexpected state %+v", status)
+	}
+	if len(s.candidatesForNetwork("tcp")) != 1 {
+		t.Fatal("outage walks all unavailable candidates")
+	}
+}
+
+func TestStableFallbackConcurrentChecksCoalesce(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", true), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Add(1)
+		go func() { defer wg.Done(); s.checkOutbounds(context.Background(), time.Minute) }()
+	}
+	wg.Wait()
+	if b.dialCount != 0 {
+		t.Fatal("concurrent requests woke reserve")
+	}
+	if s.StableStatus().State != "primary" {
+		t.Fatal("lost active selection")
+	}
+}
+
+func TestStableFallbackMissingWANDoesNotCondemnServers(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", true), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	s.stable.networkReady = func() bool { return false }
+	s.checkOutbounds(context.Background(), 0)
+	if a.dialCount != 0 || b.dialCount != 0 || s.StableStatus().State != "no_network" {
+		t.Fatal("missing WAN marked candidates down")
+	}
+	s.stable.networkReady = func() bool { return true }
+	s.checkOutbounds(context.Background(), 0)
+	if s.StableStatus().State != "primary" {
+		t.Fatal("WAN recovery failed")
+	}
+}
+
+func TestStableFallbackRecoveryTimerIsIndependentOfCheckInterval(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	s.interval = time.Second
+	s.idleTimeout = time.Millisecond
+	s.lastActive = time.Now().Add(-time.Hour)
+	s.stable.recoveryInterval = 25 * time.Millisecond
+	confirmStableFailure(s)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { defer close(done); s.loopCheck(ctx) }()
+	defer func() { cancel(); <-done }()
+	waitSelected := func(want string, timeout time.Duration) {
+		t.Helper()
+		until := time.Now().Add(timeout)
+		for time.Now().Before(until) {
+			if selectedTag(s) == want {
+				return
+			}
+			time.Sleep(time.Millisecond)
+		}
+		t.Fatalf("selected=%s, want %s within %s", selectedTag(s), want, timeout)
+	}
+	waitSelected("backup", 250*time.Millisecond)
+	a.setAvailable(true)
+	waitSelected("primary", 400*time.Millisecond)
+}
+
+func TestStableFallbackPinnedBackupSkipsRecovery(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	confirmStableFailure(s)
+	a.setAvailable(true)
+	before := a.dialCount
+	s.access.Lock()
+	s.fixed = "backup"
+	s.stable.lastRecovery = time.Now().Add(-2 * time.Minute)
+	s.access.Unlock()
+	s.checkOutbounds(context.Background(), 0)
+	if a.dialCount != before || selectedTag(s) != "backup" {
+		t.Fatal("manual backup choice triggered recovery")
+	}
+	if s.StableStatus().NextRecovery != nil {
+		t.Fatal("manual choice advertises automatic recovery")
+	}
+}
+func TestStableFallbackNextRecoveryIsNotInPast(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	confirmStableFailure(s)
+	s.access.Lock()
+	s.stable.lastRecovery = time.Time{}
+	s.access.Unlock()
+	before := time.Now()
+	status := s.StableStatus()
+	if status.NextRecovery == nil || status.NextRecovery.Before(before) {
+		t.Fatalf("invalid next recovery: %+v", status.NextRecovery)
+	}
+}
+
+type stableDelayedHealthyOutbound struct {
+	*fallbackHealthTestOutbound
+	delay time.Duration
+}
+
+func (o *stableDelayedHealthyOutbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	timer := time.NewTimer(o.delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-timer.C:
+		return o.fallbackHealthTestOutbound.DialContext(ctx, network, destination)
+	}
+}
+func TestStableFallbackManyMembersDoNotShortenActiveTimeout(t *testing.T) {
+	primary := &stableDelayedHealthyOutbound{newFallbackHealthTestOutbound("primary", true), 50 * time.Millisecond}
+	template := stableTestGroup(t, primary.fallbackHealthTestOutbound)
+	candidates := []fallbackCandidate{{tag: "primary", outbound: primary}}
+	for i := 0; i < 99; i++ {
+		node := newFallbackHealthTestOutbound(fmt.Sprint("reserve", i), true)
+		candidates = append(candidates, fallbackCandidate{tag: node.Tag(), outbound: node})
+	}
+	s := newTestFallback(candidates...)
+	s.stable = template.stable
+	s.expectedStatus = template.expectedStatus
+	s.timeout = 200 * time.Millisecond
+	s.stable.roundBudget = time.Second
+	s.checkOutbounds(context.Background(), 0)
+	if selectedTag(s) != "primary" || !s.health["primary"].alive {
+		t.Fatal("large subscription caused false active failure")
+	}
+	for _, c := range candidates[1:] {
+		if c.outbound.(*fallbackHealthTestOutbound).dialCount != 0 {
+			t.Fatal("healthy primary triggered reserve sweep")
+		}
+	}
+}
