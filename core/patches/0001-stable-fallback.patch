@@ -0,0 +1,68 @@
+package main
+
+import (
+	"context"
+	stdjson "encoding/json"
+	"fmt"
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/include"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/group"
+	"github.com/sagernet/sing/common/json"
+	"testing"
+	"time"
+)
+
+func stableReloadTestBox(t *testing.T, raw []byte) (*box.Box, option.Options) {
+	t.Helper()
+	ctx := include.Context(context.Background())
+	options, err := json.UnmarshalExtendedContext[option.Options](ctx, raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	instance, err := box.New(box.Options{Context: ctx, Options: options})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { instance.Close() })
+	return instance, options
+}
+func TestStableObservationReloadPreservesOnlyMatchingGraph(t *testing.T) {
+	raw := []byte(`{"log":{"disabled":true},"outbounds":[{"type":"fallback","tag":"g","stable":true,"outbounds":["a"]},{"type":"direct","tag":"a"}]}`)
+	instance, options := stableReloadTestBox(t, raw)
+	member, _ := instance.Outbound().Outbound("g")
+	stable := member.(*group.Fallback)
+	since := time.Now().Add(-time.Hour)
+	stable.RestoreStableObservation(&group.StableFallbackObservationSnapshot{Stats: group.StableFallbackStats{Since: since, SwitchesTotal: 7}})
+	snapshots := captureStableReloadObservations(instance, options)
+	var data map[string]any
+	stdjson.Unmarshal(raw, &data)
+	data["route"] = map[string]any{"auto_detect_interface": false}
+	routing, _ := stdjson.Marshal(data)
+	replacement, replacementOptions := stableReloadTestBox(t, routing)
+	restoreStableReloadObservations(replacement, replacementOptions, snapshots)
+	outbound, _ := replacement.Outbound().Outbound("g")
+	observed := outbound.(*group.Fallback).StableStatus()
+	if observed.Stats.Since != since || observed.Stats.SwitchesTotal != 7 {
+		t.Fatal("routing-only reload reset observations")
+	}
+	data["outbounds"].([]any)[0].(map[string]any)["recovery_successes"] = 4
+	changed, _ := stdjson.Marshal(data)
+	different, differentOptions := stableReloadTestBox(t, changed)
+	restoreStableReloadObservations(different, differentOptions, snapshots)
+	outbound, _ = different.Outbound().Outbound("g")
+	if outbound.(*group.Fallback).StableStatus().Stats.Since == since {
+		t.Fatal("changed fallback restored old observations")
+	}
+}
+func TestStableObservationReloadSnapshotRegistryIsBounded(t *testing.T) {
+	entries := []any{map[string]any{"type": "direct", "tag": "a"}}
+	for i := 0; i < 135; i++ {
+		entries = append(entries, map[string]any{"type": "fallback", "tag": fmt.Sprint("g", i), "stable": true, "outbounds": []string{"a"}})
+	}
+	raw, _ := stdjson.Marshal(map[string]any{"log": map[string]any{"disabled": true}, "outbounds": entries})
+	instance, options := stableReloadTestBox(t, raw)
+	if len(captureStableReloadObservations(instance, options)) != 128 {
+		t.Fatal("reload registry exceeded or failed its bound")
+	}
+}
