diff --git a/protocol/parser/outbound_test.go b/protocol/parser/outbound_test.go
new file mode 100644
index 0000000..7dfd9c5
--- /dev/null
+++ b/protocol/parser/outbound_test.go
@@ -0,0 +1,62 @@
+package parser
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/service"
+	"testing"
+)
+
+type captureRegistry struct {
+	adapter.OutboundRegistry
+	options any
+}
+
+func (r *captureRegistry) UnsafeCreateOutbound(_ context.Context, _ adapter.Router, _ log.ContextLogger, _ string, _ string, options any) (adapter.Outbound, error) {
+	r.options = options
+	return nil, nil
+}
+
+const realityTestLink = "vless://00000000-0000-0000-0000-000000000001@example.com:443?security=reality&sni=example.com&pbk=SSw7I859PPdN4DQ7fxV9fobXM61Ms3mqZRlIY1aJvHQ"
+
+func TestParserTLSOverrides(t *testing.T) {
+	for _, flags := range []struct{ fragment, classical bool }{{false, false}, {true, false}, {false, true}, {true, true}} {
+		r := &captureRegistry{}
+		ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), r)
+		_, err := NewOutbound(ctx, nil, nil, "test", option.ParserOutboundOptions{Link: realityTestLink, TLSRecordFragment: flags.fragment, TLSClassical: flags.classical})
+		if err != nil {
+			t.Fatal(err)
+		}
+		tls := r.options.(option.OutboundTLSOptionsWrapper).TakeOutboundTLSOptions()
+		if tls.RecordFragment != flags.fragment {
+			t.Fatal("fragment override mismatch")
+		}
+		support := tls.Reality.SupportX25519MLKEM768
+		if flags.classical {
+			if support == nil || *support {
+				t.Fatal("classical override lost")
+			}
+		} else if support != nil {
+			t.Fatal("default hybrid setting changed")
+		}
+	}
+}
+func TestParserRejectsTLSOverridesWithoutVLESSReality(t *testing.T) {
+	for _, uri := range []string{"vless://00000000-0000-0000-0000-000000000001@example.com:443?security=none", "socks://example.com:1080", "vless://00000000-0000-0000-0000-000000000001@example.com:443?security=tls&sni=example.com", "trojan://password@example.com:443?security=tls"} {
+		for _, flags := range []struct{ fragment, classical bool }{{true, false}, {false, true}, {true, true}} {
+			r := &captureRegistry{}
+			ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), r)
+			_, err := NewOutbound(ctx, nil, nil, "test", option.ParserOutboundOptions{Link: uri, TLSRecordFragment: flags.fragment, TLSClassical: flags.classical})
+			if err == nil || r.options != nil {
+				t.Fatal("unsupported override silently accepted")
+			}
+		}
+		r := &captureRegistry{}
+		ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), r)
+		if _, err := NewOutbound(ctx, nil, nil, "test", option.ParserOutboundOptions{Link: uri}); err != nil {
+			t.Fatalf("disabled overrides changed valid link: %v", err)
+		}
+	}
+}
