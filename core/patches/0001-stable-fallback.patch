@@ -0,0 +1,283 @@
+package group
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+type stableMutableGroup struct {
+	*fallbackHealthTestOutbound
+	mu          sync.Mutex
+	selected    adapter.Outbound
+	afterSelect adapter.Outbound
+}
+
+func (o *stableMutableGroup) All() []string                     { return nil }
+func (o *stableMutableGroup) AttachConnection(io.Closer) func() { return func() {} }
+func (o *stableMutableGroup) Selected(string) adapter.Outbound {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	selected := o.selected
+	if o.afterSelect != nil {
+		o.selected, o.afterSelect = o.afterSelect, nil
+	}
+	return selected
+}
+func (o *stableMutableGroup) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return o.Selected(network).DialContext(ctx, network, destination)
+}
+
+func TestStableFallbackCoordinatorFreezesNestedProbeTarget(t *testing.T) {
+	old, replacement := newFallbackHealthTestOutbound("leaf", false), newFallbackHealthTestOutbound("leaf", true)
+	wrapper := &stableMutableGroup{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("wrapper", true), selected: old, afterSelect: replacement}
+	s := stableCandidateGroup(t, fallbackCandidate{tag: wrapper.Tag(), outbound: wrapper})
+	_, _, err := s.coordinator.Check(context.Background(), s.link, s.expectedStatus, old.Tag(), wrapper, time.Second, 0)
+	if err == nil {
+		t.Fatal("probe used replacement after capturing old leaf identity")
+	}
+	_, _, err = s.coordinator.Check(context.Background(), s.link, s.expectedStatus, old.Tag(), old, time.Second, time.Minute)
+	if err == nil {
+		t.Fatal("replacement success polluted old leaf cache")
+	}
+}
+
+func TestStableFallbackDiscardsChangedNestedSelection(t *testing.T) {
+	old := &stableTrafficOutbound{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("leaf", false)}
+	replacement := newFallbackHealthTestOutbound("replacement", true)
+	wrapper := &stableMutableGroup{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("primary", true), selected: old}
+	backup := newFallbackHealthTestOutbound("backup", true)
+	s := stableCandidateGroup(t, fallbackCandidate{tag: wrapper.Tag(), outbound: wrapper}, fallbackCandidate{tag: backup.Tag(), outbound: backup})
+	old.dial = func(context.Context, string, M.Socksaddr) (net.Conn, error) {
+		wrapper.mu.Lock()
+		wrapper.selected = replacement
+		wrapper.mu.Unlock()
+		return nil, errors.New("obsolete leaf failed")
+	}
+	s.checkOutbounds(context.Background(), 0)
+	if s.StableStatus().Active != "primary" || backup.dialCount != 0 {
+		t.Fatal("old nested leaf failure demoted replacement")
+	}
+}
+
+func TestStableFallbackRevalidatesNestedTargetAfterReserveProbe(t *testing.T) {
+	old := newFallbackHealthTestOutbound("leaf", false)
+	replacement := newFallbackHealthTestOutbound("replacement", true)
+	wrapper := &stableMutableGroup{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("primary", true), selected: old}
+	backup := &stableTrafficOutbound{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("backup", true)}
+	s := stableCandidateGroup(t, fallbackCandidate{tag: wrapper.Tag(), outbound: wrapper}, fallbackCandidate{tag: backup.Tag(), outbound: backup})
+	backup.dial = func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		wrapper.mu.Lock()
+		wrapper.selected = replacement
+		wrapper.mu.Unlock()
+		return backup.fallbackHealthTestOutbound.DialContext(ctx, network, destination)
+	}
+	confirmStableFailure(s)
+	if s.StableStatus().Active != "primary" || len(s.StableStatus().Events) != 2 {
+		t.Fatal("obsolete active result committed after reserve probe")
+	}
+}
+
+type stableTrafficOutbound struct {
+	*fallbackHealthTestOutbound
+	packetCalls        int
+	rejectConfirmation bool
+	dial               func(context.Context, string, M.Socksaddr) (net.Conn, error)
+}
+
+func (o *stableTrafficOutbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	if o.dial != nil {
+		return o.dial(ctx, network, destination)
+	}
+	if o.rejectConfirmation && destination.Fqdn == "confirm.test" {
+		return nil, errors.New("confirmation refused")
+	}
+	return o.fallbackHealthTestOutbound.DialContext(ctx, network, destination)
+}
+func (o *stableTrafficOutbound) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	o.packetCalls++
+	return nil, errors.New("destination refused")
+}
+func stableCandidateGroup(t *testing.T, candidates ...fallbackCandidate) *Fallback {
+	s := newTestFallback(candidates...)
+	template := stableTestGroup(t)
+	s.stable, s.expectedStatus = template.stable, template.expectedStatus
+	return s
+}
+
+func TestStableFallbackDoesNotDialReserveForOneFailedRequest(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	health := s.health["primary"]
+	health.checked, health.alive = true, true
+	s.health["primary"] = health
+	conn, err := s.DialContext(context.Background(), "tcp", M.Socksaddr{})
+	if conn != nil {
+		conn.Close()
+	}
+	if err == nil || b.dialCount != 0 || len(s.StableStatus().Events) != 0 || s.StableStatus().State != "primary" {
+		t.Fatalf("unconfirmed traffic reached reserve: error=%v reserve=%d", err, b.dialCount)
+	}
+	// Only a committed health decision permits new traffic through the reserve.
+	confirmStableFailure(s)
+	if selectedTag(s) != "backup" {
+		t.Fatal("confirmed failure did not select backup")
+	}
+	conn, err = s.DialContext(context.Background(), "tcp", M.Socksaddr{})
+	if conn != nil {
+		conn.Close()
+	}
+	if err != nil || b.dialCount != 2 {
+		t.Fatalf("committed reserve unavailable: %v", err)
+	}
+}
+
+func TestStableFallbackCancelledClientDoesNotScheduleHealth(t *testing.T) {
+	a := &fallbackEarlyOutbound{Adapter: newFallbackHealthTestOutbound("primary", true).Adapter}
+	b := newFallbackHealthTestOutbound("backup", true)
+	s := stableCandidateGroup(t, fallbackCandidate{tag: a.Tag(), outbound: a}, fallbackCandidate{tag: b.Tag(), outbound: b})
+	ctx, cancel := context.WithCancel(context.Background())
+	conn, err := s.DialContext(ctx, "tcp", M.Socksaddr{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	cancel()
+	_, _ = conn.Write([]byte("cancelled request"))
+	select {
+	case <-s.wake:
+		t.Fatal("client cancellation was treated as a node failure")
+	default:
+	}
+}
+
+func TestStableFallbackCoordinatorDoesNotJoinReplacedDialer(t *testing.T) {
+	old := &fallbackBlockingOutbound{Adapter: newFallbackHealthTestOutbound("primary", false).Adapter, started: make(chan struct{})}
+	replacement := newFallbackHealthTestOutbound("primary", true)
+	s := stableCandidateGroup(t, fallbackCandidate{tag: old.Tag(), outbound: old})
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _, _ = s.coordinator.Check(context.Background(), s.link, s.expectedStatus, old.Tag(), old, 100*time.Millisecond, 0)
+	}()
+	defer func() { <-done }()
+	<-old.started
+	_, _, err := s.coordinator.Check(context.Background(), s.link, s.expectedStatus, replacement.Tag(), replacement, 100*time.Millisecond, 0)
+	if err != nil {
+		t.Fatalf("replacement inherited old instance failure: %v", err)
+	}
+}
+
+func TestStableFallbackDoesNotDialReserveAfterEarlyWriteFailure(t *testing.T) {
+	a := &fallbackBrokenWriteOutbound{Adapter: newFallbackHealthTestOutbound("primary", true).Adapter, early: true}
+	b := newFallbackHealthTestOutbound("backup", true)
+	s := stableCandidateGroup(t, fallbackCandidate{tag: a.Tag(), outbound: a}, fallbackCandidate{tag: b.Tag(), outbound: b})
+	conn, err := s.DialContext(context.Background(), "tcp", M.Socksaddr{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_, err = conn.Write([]byte("request"))
+	if err == nil || b.dialCount != 0 {
+		t.Fatalf("early write silently used reserve: %v calls=%d", err, b.dialCount)
+	}
+}
+
+func TestStableFallbackDoesNotOpenReservePacketSocket(t *testing.T) {
+	a := &stableTrafficOutbound{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("primary", true)}
+	b := &stableTrafficOutbound{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("backup", true)}
+	s := stableCandidateGroup(t, fallbackCandidate{tag: a.Tag(), outbound: a}, fallbackCandidate{tag: b.Tag(), outbound: b})
+	_, err := s.ListenPacket(context.Background(), M.Socksaddr{})
+	if err == nil || a.packetCalls != 1 || b.packetCalls != 0 {
+		t.Fatalf("UDP silently used reserve: %v calls=%d/%d", err, a.packetCalls, b.packetCalls)
+	}
+}
+
+func TestStableFallbackRechecksCachedFailureBeforeDeclaringNodeDown(t *testing.T) {
+	a := &stableTrafficOutbound{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("primary", false), rejectConfirmation: true}
+	b := newFallbackHealthTestOutbound("backup", true)
+	s := stableCandidateGroup(t, fallbackCandidate{tag: a.Tag(), outbound: a}, fallbackCandidate{tag: b.Tag(), outbound: b})
+	_, _, err := s.coordinator.Check(context.Background(), s.link, s.expectedStatus, MemberTag(a), a, s.timeout, 0)
+	if err == nil {
+		t.Fatal("test needs a cached failure")
+	}
+	a.setAvailable(true)
+	s.checkOutbounds(context.Background(), time.Minute)
+	if s.StableStatus().Active != "primary" || b.dialCount != 0 {
+		t.Fatal("old cached failure demoted a working primary")
+	}
+}
+
+func TestStableFallbackDiscardsReplacedOutboundBeforeFailover(t *testing.T) {
+	a := &stableTrafficOutbound{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("primary", false)}
+	replacement := newFallbackHealthTestOutbound("primary", true)
+	b := newFallbackHealthTestOutbound("backup", true)
+	s := stableCandidateGroup(t, fallbackCandidate{tag: a.Tag(), outbound: a}, fallbackCandidate{tag: b.Tag(), outbound: b})
+	var once sync.Once
+	a.dial = func(context.Context, string, M.Socksaddr) (net.Conn, error) {
+		once.Do(func() {
+			s.access.Lock()
+			defer s.access.Unlock()
+			s.candidates[0].outbound = replacement
+			s.health["primary"] = fallbackHealth{outbound: replacement}
+		})
+		return nil, errors.New("obsolete outbound")
+	}
+	s.checkOutbounds(context.Background(), 0)
+	if s.StableStatus().Active != "primary" || b.dialCount != 0 {
+		t.Fatal("obsolete result caused a failover")
+	}
+}
+
+func TestStableFallbackSwitchReasonIncludesBothProbeResults(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	confirmStableFailure(s)
+	events := s.StableStatus().Events
+	if len(events) != 3 || !strings.Contains(events[len(events)-1].Reason, "primary=request_failed; confirmation=request_failed") {
+		t.Fatalf("failure cause was discarded: %+v", events)
+	}
+}
+
+func TestStableFallbackFailedRequestSchedulesHealthWithoutDialingReserve(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	_, _ = s.DialContext(context.Background(), "tcp", M.Socksaddr{})
+	select {
+	case <-s.wake:
+	default:
+		t.Fatal("first failed connection did not schedule a health check")
+	}
+	_, _ = s.DialContext(context.Background(), "tcp", M.Socksaddr{})
+	select {
+	case <-s.wake:
+		t.Fatal("failure burst scheduled redundant health checks")
+	default:
+	}
+	if b.dialCount != 0 {
+		t.Fatal("failure notification dialed the reserve")
+	}
+}
+
+func TestStableFallbackFailureLabelsDoNotExposeEndpointOrSecret(t *testing.T) {
+	for _, test := range []struct {
+		err  error
+		want string
+	}{
+		{context.DeadlineExceeded, "timeout"},
+		{errors.New("unexpected HTTP status: 403"), "HTTP_403"},
+		{errors.New("tls failure with a private endpoint"), "tls_error"},
+		{errors.New("private-password-at-private-endpoint"), "request_failed"},
+	} {
+		if got := stableProbeError(test.err); got != test.want {
+			t.Fatalf("failure label=%s want %s", got, test.want)
+		}
+	}
+}
