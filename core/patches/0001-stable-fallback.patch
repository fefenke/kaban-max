+		}
+		if c.tag == selected && err != nil {
+			if s.stable.suspect != c.tag || s.stable.suspectOutbound != c.outbound {
+				s.stable.suspect = c.tag
+				s.stable.suspectOutbound = c.outbound
+				s.stable.confirmAfter = time.Now().Add(3 * time.Second)
+				h.lastError = "primary=" + stableProbeError(primaryError) + "; confirmation=" + stableProbeError(err)
+				s.health[c.tag] = h
+				s.appendStableEventLocked(StableFallbackEvent{At: time.Now(), From: c.tag, To: c.tag, Reason: "Suspected check failure: " + h.lastError, CheckReason: probeReason})
+				s.access.Unlock()
+				s.logger.Warn("fallback health test suspect [", probeReason, "] ", c.tag, ": ", h.lastError, "; repeating in 3s, traffic selection unchanged")
+				return false
+			}
+			s.stable.suspect = ""
+			s.stable.suspectOutbound = nil
+			s.stable.confirmAfter = time.Time{}
+		}
+		if err == nil && previouslySuspect {
+			s.stable.suspect = ""
+			s.stable.suspectOutbound = nil
+			s.stable.confirmAfter = time.Time{}
+			s.appendStableEventLocked(StableFallbackEvent{At: time.Now(), From: c.tag, To: c.tag, Reason: "Health test recovered; suspicion cancelled", CheckReason: probeReason})
+		}
+		confirmedSelectedFailure := c.tag == selected && err != nil && previouslySuspect
+		if confirmedSelectedFailure {
+			s.appendStableEventLocked(StableFallbackEvent{At: time.Now(), From: c.tag, To: c.tag, Reason: "Confirmed health test failure: primary=" + stableProbeError(primaryError) + "; confirmation=" + stableProbeError(err), CheckReason: probeReason})
+		}
+		becameUnhealthy := err != nil && (!h.checked || h.alive)
+		h.checked = true
+		h.alive = err == nil
+		h.checkedAt = at
+		h.failures = dialFailures{}
+		if err == nil {
+			if recovering {
+				h.recoverySuccesses++
+			} else {
+				h.recoverySuccesses = 0
+			}
+			h.lastError = ""
+			s.history.StoreURLTestHistory(MemberTag(c.outbound), &adapter.URLTestHistory{Time: at, Delay: delay})
+			result[c.tag] = delay
+		} else {
+			h.recoverySuccesses = 0
+			h.lastError = "primary=" + stableProbeError(primaryError) + "; confirmation=" + stableProbeError(err)
+			s.history.DeleteURLTestHistory(MemberTag(c.outbound))
+		}
+		recoveredPriority := err == nil && recovering && (h.recoverySuccesses == 1 || h.recoverySuccesses == s.stable.returnAfter)
+		if recoveredPriority {
+			s.appendStableEventLocked(StableFallbackEvent{At: time.Now(), From: selected, To: c.tag, Reason: "Recovery health test passed (" + strconv.Itoa(int(h.recoverySuccesses)) + "/" + strconv.Itoa(int(s.stable.returnAfter)) + ")", CheckReason: probeReason})
+		}
+		s.health[c.tag] = h
+		s.access.Unlock()
+		if becameUnhealthy || confirmedSelectedFailure {
+			s.logger.Warn("fallback health test confirmed failure [", probeReason, "] ", c.tag, ": ", h.lastError)
+		}
+		if err == nil && previouslySuspect {
+			s.logger.Info("fallback health test recovered [", probeReason, "] ", c.tag, "; suspicion cancelled")
+		}
+		if recoveredPriority {
+			s.logger.Info("fallback health test recovery [recovery] ", c.tag, " passed ", h.recoverySuccesses, "/", s.stable.returnAfter)
+		}
+		return err == nil
+	}
+	activeHealthy := probe(candidates[active], false)
+	if ctx.Err() != nil || stale {
+		return result
+	}
+	s.access.RLock()
+	suspected := s.stable.suspect == selected
+	s.access.RUnlock()
+	if suspected {
+		return result
+	}
+	// Bound reserve sweeps by the remaining round budget without shortening
+	// the active check. A single recovery candidate keeps the normal timeout.
+	reserveCount := len(candidates) - 1
+	if activeHealthy {
+		reserveCount = active
+	}
+	if reserveCount > 1 {
+		deadline, _ := ctx.Deadline()
+		probeTimeout = min(s.timeout, time.Until(deadline)*4/5/time.Duration(2*reserveCount))
+	}
+	if activeHealthy {
+		if active > 0 && recoveryDue && fixed == "" {
+			s.access.Lock()
+			s.stable.lastRecovery = time.Now()
+			s.access.Unlock()
+			for _, c := range candidates[:active] {
+				if probe(c, true) {
+					break
+				} // restore highest recoverable priority, no sweep below it
+				if ctx.Err() != nil || stale {
+					return result
+				}
+			}
+		}
+	} else {
+		s.access.Lock()
+		s.stable.lastRecovery = time.Now()
+		s.access.Unlock()
+		// If the active reserve dies, higher priorities may already have recovered.
+		order := append(append([]fallbackCandidate(nil), candidates[:active]...), candidates[active+1:]...)
+		for _, c := range order {
+			if probe(c, false) {
+				break
+			}
+			if ctx.Err() != nil || stale {
+				return result
+			}
+		}
+	}
+	s.access.Lock()
+	if s.selected != selected || len(s.candidates) != len(candidates) {
+		s.access.Unlock()
+		return result
+	}
+	for i, c := range candidates {
+		if s.candidates[i].tag != c.tag || s.candidates[i].outbound != c.outbound {
+			s.access.Unlock()
+			return result
+		}
+		if target, checked := probeTargets[c.tag]; checked && !urltest.SameProbeTarget(c.outbound, target) {
+			s.access.Unlock()
+			s.requestCheck()
+			return result
+		}
+	}
+	old := s.selected
+	s.selected = s.selectAvailableLocked()
+	next := s.selected
+	if old != "" && next != old {
+		reason := "Confirmed health failure"
+		if failure := s.health[candidates[active].tag].lastError; !activeHealthy && failure != "" {
+			reason += ": " + failure
+		}
+		if activeHealthy {
+			reason = "Primary passed recovery threshold"
+		}
+		s.appendStableEventLocked(StableFallbackEvent{At: time.Now(), From: old, To: next, Reason: reason, CheckReason: checkReason})
+	}
+	s.recordStableSelectionLocked(old, next)
+	s.access.Unlock()
+	s.interruptSelection(old, next)
+	return result
+}
+
+func (s *Fallback) StableStatus() *StableFallbackStatus {
+	if s.stable == nil {
+		return nil
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	s.purgeStableEventsLocked(time.Now())
+	status := &StableFallbackStatus{Stats: s.stableStatsLocked(time.Now()), Active: s.selected, State: "degraded", Events: append([]StableFallbackEvent(nil), s.stable.events...)}
+	for i, c := range s.candidates {
+		h := s.health[c.tag]
+		state := "standby"
+		if c.tag == s.selected {
+			if !h.checked {
+				state = "unknown"
+				status.State = "unknown"
+			} else if h.alive {
+				state = "active"
+				status.State = "backup"
+				if i == 0 {
+					status.State = "primary"
+				}
+			} else {
+				state = "unhealthy"
+			}
+		} else if h.checked && !h.alive {
+			state = "unhealthy"
+		} else if h.recoverySuccesses > 0 {
+			state = "recovering"
+		}
+		status.Members = append(status.Members, StableFallbackMember{Name: c.tag, State: state, LastCheck: h.checkedAt, RecoverySuccesses: h.recoverySuccesses})
+	}
+	if s.stable.suspect == s.selected && s.stable.suspect != "" {
+		status.State = "suspect"
+		next := s.stable.confirmAfter
+		status.NextConfirmation = &next
+	}
+	if s.stable.noNetwork {
+		status.State = "no_network"
+	}
+	if status.State == "backup" && s.fixed == "" {
+		next := s.stable.lastRecovery.Add(s.stable.recoveryInterval)
+		if next.Before(time.Now()) {
+			next = time.Now()
+		}
+		status.NextRecovery = &next
+	}
+	return status
+}
diff --git a/protocol/group/fallback_stable_observation.go b/protocol/group/fallback_stable_observation.go
new file mode 100644
index 0000000..3c47b80
--- /dev/null
+++ b/protocol/group/fallback_stable_observation.go
@@ -0,0 +1,224 @@
+package group
+
+import "time"
+
+type StableFallbackMemberStats struct {
+	Name             string  `json:"name"`
+	SelectedSeconds  float64 `json:"selected_seconds"`
+	ConnectionErrors uint64  `json:"connection_errors"`
+	FailedChecks     uint64  `json:"failed_checks"`
+	SwitchesAway     uint64  `json:"switches_away"`
+}
+type StableFallbackStats struct {
+	Since         time.Time                   `json:"since"`
+	SelectedSince time.Time                   `json:"selected_since"`
+	SwitchesTotal uint64                      `json:"switches_total"`
+	BackupSeconds float64                     `json:"backup_seconds"`
+	Members       []StableFallbackMemberStats `json:"members"`
+}
+type stableObservation struct {
+	since           time.Time
+	selectedSince   time.Time
+	accountedAt     time.Time
+	statsSelected   string
+	statsBackup     bool
+	switchesTotal   uint64
+	backupSeconds   float64
+	memberStats     map[string]StableFallbackMemberStats
+	suspect         string
+	suspectOutbound any
+	confirmAfter    time.Time
+	pendingReason   string
+}
+
+func (s *Fallback) initStableStatsLocked(now time.Time) {
+	o := s.stable
+	if o.since.IsZero() {
+		o.since = now
+	}
+	if o.memberStats == nil {
+		o.memberStats = make(map[string]StableFallbackMemberStats)
+	}
+	// Keep bookkeeping proportional to current members when providers replace tags.
+	if len(o.memberStats) > len(s.candidates)+1 {
+		allowed := make(map[string]bool, len(s.candidates)+1)
+		allowed[o.statsSelected] = true
+		for _, candidate := range s.candidates {
+			allowed[candidate.tag] = true
+		}
+		for tag := range o.memberStats {
+			if !allowed[tag] {
+				delete(o.memberStats, tag)
+			}
+		}
+	}
+	if o.statsSelected == "" && s.selected != "" {
+		o.statsSelected = s.selected
+		o.selectedSince = o.since
+		o.statsBackup = s.stableIsBackupLocked(s.selected)
+	}
+}
+func (s *Fallback) stableIsBackupLocked(tag string) bool {
+	for i, c := range s.candidates {
+		if c.tag == tag {
+			return i > 0
+		}
+	}
+	return false
+}
+func (s *Fallback) stableSelectionStatsLocked(now time.Time) {
+	s.initStableStatsLocked(now)
+	o := s.stable
+	if o.statsSelected == s.selected {
+		o.statsBackup = s.stableIsBackupLocked(s.selected)
+		return
+	}
+	elapsed := o.elapsedSelected(now)
+	old := o.memberStats[o.statsSelected]
+	old.Name = o.statsSelected
+	old.SelectedSeconds += elapsed
+	old.SwitchesAway++
+	o.memberStats[o.statsSelected] = old
+	if o.statsBackup {
+		o.backupSeconds += elapsed
+	}
+	o.switchesTotal++
+	o.statsSelected = s.selected
+	o.selectedSince = now
+	o.accountedAt = time.Time{}
+	o.statsBackup = s.stableIsBackupLocked(s.selected)
+	o.suspect = ""
+	o.suspectOutbound = nil
+	o.confirmAfter = time.Time{}
+}
+func (s *Fallback) stableStatsLocked(now time.Time) StableFallbackStats {
+	s.stableSelectionStatsLocked(now)
+	o := s.stable
+	stats := StableFallbackStats{Since: o.since, SelectedSince: o.selectedSince, SwitchesTotal: o.switchesTotal, BackupSeconds: o.backupSeconds}
+	elapsed := o.elapsedSelected(now)
+	if o.statsBackup {
+		stats.BackupSeconds += elapsed
+	}
+	retained := make(map[string]StableFallbackMemberStats, len(s.candidates))
+	for _, c := range s.candidates {
+		m := o.memberStats[c.tag]
+		m.Name = c.tag
+		retained[c.tag] = m
+		if c.tag == o.statsSelected {
+			m.SelectedSeconds += elapsed
+		}
+		stats.Members = append(stats.Members, m)
+	}
+	o.memberStats = retained
+	return stats
+}
+func (s *Fallback) purgeStableEventsLocked(now time.Time) {
+	events := s.stable.events[:0]
+	cutoff := now.Add(-24 * time.Hour)
+	for _, event := range s.stable.events {
+		if !event.At.Before(cutoff) {
+			events = append(events, event)
+		}
+	}
+	if len(events) > 50 {
+		events = events[len(events)-50:]
+	}
+	s.stable.events = events
+}
+func (s *Fallback) appendStableEventLocked(event StableFallbackEvent) {
+	now := time.Now()
+	s.purgeStableEventsLocked(now)
+	if event.At.Before(now.Add(-24 * time.Hour)) {
+		return
+	}
+	short := func(v string) string {
+		if len(v) > 64 {
+			return v[:64]
+		}
+		return v
+	}
+	event.From = short(event.From)
+	event.To = short(event.To)
+	s.stable.events = append(s.stable.events, event)
+	if len(s.stable.events) > 50 {
+		copy(s.stable.events, s.stable.events[1:])
+		s.stable.events = s.stable.events[:50]
+	}
+}
+
+// StableFallbackObservationSnapshot is runtime-only bookkeeping. It deliberately
+// contains no health verdict, pending confirmation, pin, or connection state.
+type StableFallbackObservationSnapshot struct {
+	Stats      StableFallbackStats
+	Events     []StableFallbackEvent
+	Active     string
+	CapturedAt time.Time
+}
+
+func (s *Fallback) ExportStableObservation() *StableFallbackObservationSnapshot {
+	if s.stable == nil {
+		return nil
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	now := time.Now()
+	s.purgeStableEventsLocked(now)
+	return &StableFallbackObservationSnapshot{Stats: s.stableStatsLocked(now), Events: append([]StableFallbackEvent(nil), s.stable.events...), Active: s.selected, CapturedAt: now}
+}
+
+// RestoreStableObservation is called before Start, only after the CLI verified
+// that this group's complete connection graph has the same fingerprint.
+func (s *Fallback) RestoreStableObservation(snapshot *StableFallbackObservationSnapshot) {
+	if s.stable == nil || snapshot == nil {
+		return
+	}
+	s.access.Lock()
+	defer s.access.Unlock()
+	o := s.stable
+	o.since = snapshot.Stats.Since
+	o.selectedSince = snapshot.Stats.SelectedSince
+	o.statsSelected = snapshot.Active
+	o.accountedAt = time.Now()
+	o.switchesTotal = snapshot.Stats.SwitchesTotal
+	o.backupSeconds = snapshot.Stats.BackupSeconds
+	o.memberStats = make(map[string]StableFallbackMemberStats, len(snapshot.Stats.Members))
+	for _, member := range snapshot.Stats.Members {
+		o.memberStats[member.Name] = member
+	}
+	o.events = nil
+	for _, event := range snapshot.Events {
+		s.appendStableEventLocked(event)
+	}
+}
+func (o *stableObservation) elapsedSelected(now time.Time) float64 {
+	baseline := o.selectedSince
+	if o.accountedAt.After(baseline) {
+		baseline = o.accountedAt
+	}
+	return max(0, now.Sub(baseline).Seconds())
+}
+func (s *Fallback) recordStableSelectionLocked(oldSelected, newSelected string) {
+	if s.stable != nil {
+
+		initial := s.stable.statsSelected == ""
+		s.initStableStatsLocked(time.Now())
+		if initial && oldSelected != "" {
+			s.stable.statsSelected = oldSelected
+			s.stable.statsBackup = s.stableIsBackupLocked(oldSelected)
+		}
+		s.stableSelectionStatsLocked(time.Now())
+		if oldSelected != "" && oldSelected != newSelected {
+			events := s.stable.events
+			alreadyRecorded := len(events) > 0 && events[len(events)-1].From == oldSelected && events[len(events)-1].To == newSelected
+			if !alreadyRecorded {
+				reason := "Selection changed"
+				if s.fixed != "" {
+					reason = "Manual selection"
+				}
+				s.appendStableEventLocked(StableFallbackEvent{At: time.Now(), From: oldSelected, To: newSelected, Reason: reason})
+			}
+		}
+
+	}
+
+}
diff --git a/protocol/group/fallback_stable_observation_test.go b/protocol/group/fallback_stable_observation_test.go
new file mode 100644
index 0000000..9ebc99b
--- /dev/null
+++ b/protocol/group/fallback_stable_observation_test.go
@@ -0,0 +1,236 @@
+package group
+
+import (
+	"context"
+	"errors"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func expireStableSuspicion(s *Fallback) {
+	s.access.Lock()
+	s.stable.confirmAfter = time.Now().Add(-time.Millisecond)
+	s.access.Unlock()
+}
+func confirmStableFailure(s *Fallback) {
+	s.checkOutbounds(context.Background(), 0)
+	expireStableSuspicion(s)
+	s.checkOutbounds(context.Background(), 0)
+}
+func TestStableSuspicionRequiresFreshSecondRound(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	s.checkOutbounds(context.Background(), 0)
+	st := s.StableStatus()
+	if st.State != "suspect" || st.NextConfirmation == nil || b.dialCount != 0 || selectedTag(s) != "primary" {
+		t.Fatalf("first failure switched: %+v", st)
+	}
+	if time.Until(*st.NextConfirmation) < 2900*time.Millisecond {
+		t.Fatal("confirmation delay shorter than 3 seconds")
+	}
+	s.checkOutbounds(context.Background(), 0)
+	if a.dialCount != 2 || b.dialCount != 0 {
+		t.Fatal("early check bypassed confirmation deadline")
+	}
+	expireStableSuspicion(s)
+	s.checkOutbounds(context.Background(), time.Hour)
+	if a.dialCount != 4 || b.dialCount != 1 || selectedTag(s) != "backup" {
+		t.Fatal("second fresh failed round did not switch")
+	}
+	if s.StableStatus().Stats.Members[0].FailedChecks != 2 {
+		t.Fatal("failed round count lost")
+	}
+}
+func TestStableSuccessfulProbeCancelsSuspicion(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	s.checkOutbounds(context.Background(), 0)
+	a.setAvailable(true)
+	expireStableSuspicion(s)
+	s.checkOutbounds(context.Background(), 0)
+	if s.StableStatus().State == "suspect" || b.dialCount != 0 {
+		t.Fatal("success did not cancel suspicion")
+	}
+	a.setAvailable(false)
+	s.checkOutbounds(context.Background(), 0)
+	if selectedTag(s) != "primary" || b.dialCount != 0 {
+		t.Fatal("old failure survived success")
+	}
+}
+func TestStableStatsAndEventBounds(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", true), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	s.StableStatus()
+	s.access.Lock()
+	s.stable.selectedSince = time.Now().Add(-2 * time.Second)
+	s.access.Unlock()
+	s.recordDialFailure(s.candidates[0], errors.New("destination failed"))
+	s.SelectOutbound("backup")
+	status := s.StableStatus()
+	if status.Stats.SwitchesTotal != 1 || status.Stats.Members[0].SelectedSeconds < 2 || status.Stats.Members[0].ConnectionErrors != 1 || status.Stats.Members[0].SwitchesAway != 1 {
+		t.Fatalf("wrong stats: %+v", status.Stats)
+	}
+	s.access.Lock()
+	s.stable.selectedSince = time.Now().Add(-time.Second)
+	for i := 0; i < 70; i++ {
+		s.appendStableEventLocked(StableFallbackEvent{At: time.Now(), Reason: "test"})
+	}
+	s.access.Unlock()
+	status = s.StableStatus()
+	if len(status.Events) != 50 || status.Stats.BackupSeconds < 1 {
+		t.Fatalf("bounds or elapsed wrong: %+v", status)
+	}
+	s.access.Lock()
+	s.stable.events[0].At = time.Now().Add(-25 * time.Hour)
+	s.access.Unlock()
+	if len(s.StableStatus().Events) != 49 {
+		t.Fatal("expired event retained")
+	}
+}
+
+func TestStableObservationRestoreDoesNotRestoreHealthOrDoubleCount(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", true), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	s.StableStatus()
+	s.access.Lock()
+	s.stable.selectedSince = time.Now().Add(-2 * time.Second)
+	s.access.Unlock()
+	snapshot := s.ExportStableObservation()
+	replacement := stableTestGroup(t, a, b)
+	replacement.RestoreStableObservation(snapshot)
+	st := replacement.StableStatus()
+	if st.Stats.Since != snapshot.Stats.Since || st.Stats.Members[0].SelectedSeconds < 2 || st.Stats.Members[0].SelectedSeconds > 2.1 {
+		t.Fatalf("elapsed doubled or reset: %+v", st.Stats)
+	}
+	if replacement.health["primary"].checked || replacement.stable.suspect != "" {
+		t.Fatal("runtime health restored")
+	}
+}
+
+func TestStableSuspectHonorsManualPinUntilSecondFailure(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", true), newFallbackHealthTestOutbound("backup", false)
+	s := stableTestGroup(t, a, b)
+	if !s.SelectOutbound("backup") {
+		t.Fatal("pin failed")
+	}
+	s.checkOutbounds(context.Background(), 0)
+	if s.Fixed() != "backup" || selectedTag(s) != "backup" || a.dialCount != 0 {
+		t.Fatal("suspect released manual choice or probed another member")
+	}
+}
+func TestStableConfirmationSuccessCancelsSuspicion(t *testing.T) {
+	node := &stableTrafficOutbound{fallbackHealthTestOutbound: newFallbackHealthTestOutbound("primary", false)}
+	backup := newFallbackHealthTestOutbound("backup", true)
+	s := stableCandidateGroup(t, fallbackCandidate{tag: node.Tag(), outbound: node}, fallbackCandidate{tag: backup.Tag(), outbound: backup})
+	s.checkOutbounds(context.Background(), 0)
+	expireStableSuspicion(s)
+	node.dial = func(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+		if destination.Fqdn == "confirm.test" {
+			return newFallbackHealthTestOutbound("confirmation", true).DialContext(ctx, network, destination)
+		}
+		return nil, errors.New("primary target unavailable")
+	}
+	s.checkOutbounds(context.Background(), 0)
+	if s.StableStatus().State != "primary" || backup.dialCount != 0 {
+		t.Fatal("confirmation target success did not cancel suspicion")
+	}
+}
+
+func TestStableStatsElapsedReadsDoNotAccumulateTwice(t *testing.T) {
+	a := newFallbackHealthTestOutbound("primary", true)
+	s := stableTestGroup(t, a)
+	s.StableStatus()
+	s.access.Lock()
+	s.stable.selectedSince = time.Now().Add(-2 * time.Second)
+	s.access.Unlock()
+	first := s.StableStatus().Stats.Members[0].SelectedSeconds
+	second := s.StableStatus().Stats.Members[0].SelectedSeconds
+	if first < 2 || second-first > .05 {
+		t.Fatal("status read double counted elapsed selection")
+	}
+}
+func TestStableSuspicionTimerHonorsIdleConfirmationDeadline(t *testing.T) {
+	a, b := newFallbackHealthTestOutbound("primary", false), newFallbackHealthTestOutbound("backup", true)
+	s := stableTestGroup(t, a, b)
+	s.interval = time.Minute
+	s.idleTimeout = time.Millisecond
+	s.lastActive = time.Now().Add(-time.Hour)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan struct{})
+	go func() { defer close(done); s.loopCheck(ctx) }()
+	defer func() { cancel(); <-done }()
+	deadline := time.Now().Add(4 * time.Second)
+	for time.Now().Before(deadline) {
+		if selectedTag(s) == "backup" {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("idle suspicion never ran its fresh confirmation")
+}
+
+type stableSwitchCountingLogger struct {
+	log.ContextLogger
+	switches atomic.Uint64
+}
+
+func (l *stableSwitchCountingLogger) Info(args ...any) {
+	if len(args) > 0 && args[0] == "fallback switched from " {
+		l.switches.Add(1)
+	}
+}
+func TestStableConcurrentSelectionsAccountEveryCommittedSwitch(t *testing.T) {
+	a, b, c := newFallbackHealthTestOutbound("a", true), newFallbackHealthTestOutbound("b", true), newFallbackHealthTestOutbound("c", true)
+	s := stableTestGroup(t, a, b, c)
+	s.StableStatus()
+	logger := &stableSwitchCountingLogger{ContextLogger: s.logger}
+	s.logger = logger
+	var workers sync.WaitGroup
+	start := make(chan struct{})
+	for worker := 0; worker < 12; worker++ {
+		workers.Add(1)
+		go func(index int) {
+			defer workers.Done()
+			<-start
+			for i := 0; i < 200; i++ {
+				s.SelectOutbound([]string{"a", "b", "c"}[(index+i)%3])
+			}
+		}(worker)
+	}
+	close(start)
+	workers.Wait()
+	stats := s.StableStatus().Stats
+	if stats.SwitchesTotal != logger.switches.Load() {
+		t.Fatalf("committed %d switches but accounted %d", logger.switches.Load(), stats.SwitchesTotal)
+	}
+	var away uint64
+	for _, member := range stats.Members {
+		away += member.SwitchesAway
+	}
+	if away != stats.SwitchesTotal {
+		t.Fatalf("member transitions %d != group %d", away, stats.SwitchesTotal)
+	}
+}
+func TestStableDefaultConfirmationAcceptsGenerate204(t *testing.T) {
+	stable, err := newStableFallback(option.FallbackOutboundOptions{Stable: true, URL: "https://primary.example/generate_204"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stable.confirmURL != "https://cp.cloudflare.com/generate_204" || !stable.confirmStatus.Contains(204) || stable.confirmStatus.Contains(200) {
+		t.Fatalf("wrong confirmation default %s status=%v", stable.confirmURL, stable.confirmStatus)
+	}
+	custom, err := newStableFallback(option.FallbackOutboundOptions{Stable: true, ConfirmURL: "https://custom.example/", ConfirmExpectedStatus: "201"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if custom.confirmURL != "https://custom.example/" || !custom.confirmStatus.Contains(201) || custom.confirmStatus.Contains(204) {
+		t.Fatal("explicit confirmation settings changed")
+	}
+}
diff --git a/protocol/group/fallback_stable_regression_test.go b/protocol/group/fallback_stable_regression_test.go
new file mode 100644
index 0000000..c462be0
