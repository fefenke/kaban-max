+
+// DNS matching keeps its query/response semantics. Data routing conservatively
+// holds the section's scope until the first valid remote set is available.
+func unavailableRouteSet(set adapter.RuleSet, metadata *adapter.InboundContext) bool {
+	if metadata.QueryType != 0 || metadata.DestinationAddressMatchFromResponse {
+		return false
+	}
+	remote, ok := set.(*RemoteRuleSet)
+	if !ok {
+		return false
+	}
+	remote.access.RLock()
+	unavailable := remote.startedEmpty && remote.revision == 0
+	remote.access.RUnlock()
+	if unavailable {
+		metadata.UnavailableRuleSet = remote.tag
+	}
+	return unavailable
+}
