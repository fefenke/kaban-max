diff --git a/common/autoroute/web_quic.go b/common/autoroute/web_quic.go
new file mode 100644
--- /dev/null
+++ b/common/autoroute/web_quic.go
@@ -0,0 +1,40 @@
+//go:build with_quic
+
+package autoroute
+
+import (
+	"context"
+	"crypto/tls"
+	"github.com/sagernet/quic-go"
+	"github.com/sagernet/quic-go/http3"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"net"
+	"net/http"
+	"time"
+)
+
+// UDP/QUIC failures require real HTTP/3 data over the selected outbound.
+// A TCP HTTPS response must never claim that a UDP alternative works.
+func newWebQUICTransport(outbound N.Dialer, destination M.Socksaddr, config *tls.Config) (http.RoundTripper, func()) {
+	transport := &http3.Transport{
+		DisableCompression:     true,
+		TLSClientConfig:        config,
+		MaxResponseHeaderBytes: 8192,
+		Dial: func(ctx context.Context, _ string, tlsConfig *tls.Config, _ *quic.Config) (*quic.Conn, error) {
+			socket, err := outbound.ListenPacket(ctx, destination)
+			if err != nil {
+				return nil, err
+			}
+			peer := &net.UDPAddr{IP: net.IP(destination.Addr.AsSlice()), Port: int(destination.Port)}
+			conn, err := quic.DialEarly(ctx, socket, peer, tlsConfig, &quic.Config{HandshakeIdleTimeout: 5 * time.Second, MaxIdleTimeout: 5 * time.Second})
+			if err != nil {
+				socket.Close()
+				return nil, err
+			}
+			context.AfterFunc(conn.Context(), func() { socket.Close() })
+			return conn, nil
+		},
+	}
+	return transport, func() { transport.Close() }
+}
diff --git a/common/autoroute/web_quic_stub.go b/common/autoroute/web_quic_stub.go
new file mode 100644
--- /dev/null
+++ b/common/autoroute/web_quic_stub.go
@@ -0,0 +1,20 @@
+//go:build !with_quic
+
+package autoroute
+
+import (
+	"crypto/tls"
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"net/http"
+)
+
+type unsupportedQUICTransport struct{}
+
+func (unsupportedQUICTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return nil, errors.New("quic_verification_unavailable")
+}
+func newWebQUICTransport(N.Dialer, M.Socksaddr, *tls.Config) (http.RoundTripper, func()) {
+	return unsupportedQUICTransport{}, func() {}
+}
