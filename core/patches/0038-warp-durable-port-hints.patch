+package adapter
+
+// WARPPathStatus contains no profile credentials or remote addresses.
+type WARPPathStatus struct {
+	Tag         string `json:"tag"`
+	ProfileID   string `json:"profile_id"`
+	Port        uint16 `json:"port"`
+	HandshakeAt int64  `json:"handshake_at"`
+	DataAt      int64  `json:"data_at"`
+	Instance    string `json:"instance"`
+}
