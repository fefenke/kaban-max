diff --git a/experimental/clashapi/warp_paths.go b/experimental/clashapi/warp_paths.go
new file mode 100644
index 0000000..5f094e8
--- /dev/null
+++ b/experimental/clashapi/warp_paths.go
@@ -0,0 +1,22 @@
+package clashapi
+
+import (
+	"github.com/go-chi/render"
+	"github.com/sagernet/sing-box/adapter"
+	"net/http"
+)
+
+func warpPaths(manager adapter.EndpointManager) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		paths := []adapter.WARPPathStatus{}
+		if manager != nil {
+			for _, endpoint := range manager.Endpoints() {
+				if reporter, ok := endpoint.(interface{ WARPPathStatus() adapter.WARPPathStatus }); ok {
+					paths = append(paths, reporter.WARPPathStatus())
+				}
+			}
+		}
+		render.JSON(w, r, render.M{"endpoints": paths})
+	}
+}
