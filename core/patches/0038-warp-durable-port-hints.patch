+
+// A RAM hint may be newer than the durable boot hint. Neither pins the bind.
+func warpListenPortHint(options option.WARPEndpointOptions, cached uint16) uint16 {
+	if options.ListenPort != 0 || options.Profile.Recreate {
+		return 0
+	}
+	if cached != 0 {
+		return cached
+	}
+	return options.ListenPortHint
+}
+
+func (w *Endpoint) WARPPathStatus() adapter.WARPPathStatus {
+	status := adapter.WARPPathStatus{Tag: w.Tag(), ProfileID: w.options.Profile.ID, Instance: w.pathInstance}
+	if w.options.ListenPort != 0 || w.options.Profile.Recreate {
+		return status
+	}
+	w.access.RLock()
+	defer w.access.RUnlock()
+	if path, ok := w.endpoint.(interface {
+		WARPPathStats() (uint16, int64, int64, uint64)
+	}); ok {
+		var epoch uint64
+		status.Port, status.HandshakeAt, status.DataAt, epoch = path.WARPPathStats()
+		status.Instance += ":" + strconv.FormatUint(epoch, 10)
+	}
+	return status
+}
