--- /dev/null
+++ b/common/autoroute/ip_failure.go
@@ -0,0 +1,190 @@
+package autoroute
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/common/dialer"
+	C "github.com/sagernet/sing-box/constant"
+	"net"
+	"net/netip"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// DNS confirms a domain/IP pair. A failed confirmation never discards an
+// attested address: retain the original identity only for first-match policy.
+func (m *Manager) bindDomain(ctx context.Context, q Query) Query {
+	s, ok := m.source(q.Source)
+	if !ok || s.Mode != "web" || q.Domain == "" || m.protected(q) || m.loggedFailure(q) == nil {
+		return q
+	}
+	addresses, ttl, err := m.Lookup(ctx, q.Domain)
+	if err == nil && ttl > 0 && containsIP(addresses, q.IP) {
+		return q
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, event := range m.events {
+		if event.Query == q && event.Failure != nil {
+			event.ObservedDomain = q.Domain
+			event.Domain = ""
+			event.DomainKnown = false
+		}
+	}
+	q.Domain = ""
+	return q
+}
+
+// Wrap the actual serial dial, after the winning source rule has been chosen.
+// Each member gets its own concrete IP: never pin a whole DNS set to one lease.
+func WrapDial(ctx context.Context, d N.Dialer) N.Dialer {
+	item, ok := ctx.Value(observationKey{}).(observation)
+	if !ok {
+		return d
+	}
+	return &scopedDialer{Dialer: d, item: item}
+}
+
+func (m *Manager) warpOutput(tag string, trail []string) bool {
+	if len(trail) > 8 {
+		return false
+	}
+	for _, old := range trail {
+		if old == tag {
+			return false
+		}
+	}
+	out, ok := m.Outbound(tag)
+	if !ok {
+		return false
+	}
+	if out.Type() == "warp" {
+		for _, dep := range out.Dependencies() {
+			d, ok := m.Outbound(dep)
+			if !ok || d.Type() != "direct" || len(d.Dependencies()) != 0 {
+				return false
+			}
+		}
+		return true
+	}
+	if out.Type() != "fallback" && out.Type() != "selector" && out.Type() != "urltest" {
+		return false
+	}
+	if len(out.Dependencies()) == 0 {
+		return false
+	}
+	for _, dep := range out.Dependencies() {
+		if !m.warpOutput(dep, append(append([]string{}, trail...), tag)) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *Manager) loggedFailureCount(q Query) int {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	count := 0
+	var latest time.Time
+	for _, event := range m.events {
+		if event.Query == q && event.Failure != nil && time.Since(event.Failure.At) < time.Hour && event.Failure.At.After(latest) {
+			count = event.Count
+			latest = event.Failure.At
+		}
+	}
+	return count
+}
+
+type scopedDialer struct {
+	N.Dialer
+	item observation
+}
+
+func (d *scopedDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	return d.dial(ctx, network, destination, func(c context.Context, selected N.Dialer, original bool) (net.Conn, error) {
+		return selected.DialContext(c, network, destination)
+	})
+}
+
+type observedDialError struct {
+	error
+	attempt *Event
+}
+
+func (e *observedDialError) Unwrap() error { return e.error }
+
+type observedConn struct {
+	net.Conn
+	attempt *Event
+}
+
+func (c *observedConn) Upstream() any           { return c.Conn }
+func (c *observedConn) ReaderReplaceable() bool { return true }
+func (c *observedConn) WriterReplaceable() bool { return true }
+
+func WrapParallelDial(ctx context.Context, base dialer.ParallelInterfaceDialer) dialer.ParallelInterfaceDialer {
+	item, ok := ctx.Value(observationKey{}).(observation)
+	if !ok {
+		return base
+	}
+	return &scopedInterfaceDialer{scopedDialer: &scopedDialer{Dialer: base, item: item}, base: base}
+}
+
+type scopedInterfaceDialer struct {
+	*scopedDialer
+	base dialer.ParallelInterfaceDialer
+}
+
+func (d *scopedInterfaceDialer) DialParallelInterface(ctx context.Context, network string, destination M.Socksaddr, strategy *C.NetworkStrategy, types, fallback []C.InterfaceType, delay time.Duration) (net.Conn, error) {
+	return d.dial(ctx, network, destination, func(c context.Context, selected N.Dialer, original bool) (net.Conn, error) {
+		if original {
+			return d.base.DialParallelInterface(c, network, destination, strategy, types, fallback, delay)
+		}
+		if parallel, ok := selected.(dialer.ParallelNetworkDialer); ok {
+			return parallel.DialParallelNetwork(c, network, destination, []netip.Addr{destination.Addr}, strategy, types, fallback, delay)
+		}
+		return selected.DialContext(c, network, destination)
+	})
+}
+func (d *scopedInterfaceDialer) ListenSerialInterfacePacket(ctx context.Context, destination M.Socksaddr, strategy *C.NetworkStrategy, types, fallback []C.InterfaceType, delay time.Duration) (net.PacketConn, error) {
+	return d.base.ListenSerialInterfacePacket(ctx, destination, strategy, types, fallback, delay)
+}
+
+func (d *scopedDialer) dial(ctx context.Context, network string, destination M.Socksaddr, call func(context.Context, N.Dialer, bool) (net.Conn, error)) (net.Conn, error) {
+	m, event := d.item.manager, d.item.event
+	if network != "tcp" || !destination.IsIP() {
+		return call(ctx, d.Dialer, true)
+	}
+	m.mu.Lock()
+	attempt := *event
+	m.mu.Unlock()
+	attempt.routedLease, attempt.routedTarget = "", ""
+	attempt.Failure = nil
+	q := attempt.Query
+	q.IP = destination.Addr.Unmap().String()
+	attempt.Query = q
+	meta := metadata(q)
+	meta.DestinationAddresses = []netip.Addr{destination.Addr.Unmap()}
+	target := m.SelectForEvent(ctx, q.Source, &meta, &attempt)
+	dialer := d.Dialer
+	if target != q.Source {
+		if out, ok := m.Outbound(target); ok {
+			dialer = out
+		} else {
+			target = q.Source
+			attempt.routedLease, attempt.routedTarget = "", ""
+		}
+	}
+	// The selected outbound may itself use Direct internally. Do not attribute
+	// its transport or a cancelled sibling racer as the winning application dial.
+	dialCtx := context.WithValue(ctx, observationKey{}, nil)
+	conn, err := call(dialCtx, dialer, target == q.Source)
+	if err != nil {
+		if attempt.routedLease != "" {
+			m.Failed(&attempt, err)
+		}
+		return nil, &observedDialError{error: err, attempt: &attempt}
+	}
+	return &observedConn{Conn: conn, attempt: &attempt}, nil
+}
