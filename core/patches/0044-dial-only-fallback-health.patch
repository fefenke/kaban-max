-		return
-	}
-	if err == nil || errors.Is(err, io.EOF) || errors.Is(err, net.ErrClosed) || errors.Is(err, context.Canceled) || c.ctx.Err() != nil || c.fallback.ctx.Err() != nil {
-		return
-	}
-	c.once.Do(func() { c.fallback.recordDialFailure(c.candidate, err) })
-}
-func (c *stableFailureConn) Read(p []byte) (int, error) {
