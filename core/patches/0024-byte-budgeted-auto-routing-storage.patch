diff --git a/common/autoroute/storage.go b/common/autoroute/storage.go
new file mode 100644
--- /dev/null
+++ b/common/autoroute/storage.go
@@ -0,0 +1,217 @@
+package autoroute
+
+import (
+	"encoding/json"
+	"time"
+)
+
+// Accounted bytes deliberately include object/map overhead and a multiplier for
+// separately allocated strings. This is an admission budget, not process RSS.
+func storageBytes(value any) int {
+	raw, err := json.Marshal(value)
+	if err != nil {
+		return 1 << 20
+	}
+	return 512 + 2*len(raw)
+}
+func (m *Manager) memoryLimit() int {
+	limit := 4 << 20
+	configured := false
+	for _, source := range m.sources {
+		if source.MemoryBytes >= 1<<20 && source.MemoryBytes <= 32<<20 && (!configured || source.MemoryBytes < limit) {
+			limit = source.MemoryBytes
+			configured = true
+		}
+	}
+	return limit
+}
+func (m *Manager) retention() time.Duration {
+	seconds := 3600
+	configured := false
+	for _, source := range m.sources {
+		if source.CleanupSeconds >= 60 && source.CleanupSeconds <= 604800 && (!configured || source.CleanupSeconds < seconds) {
+			seconds = source.CleanupSeconds
+			configured = true
+		}
+	}
+	return time.Duration(seconds) * time.Second
+}
+func (m *Manager) essentialBytesLocked() int {
+	bytes := 0
+	for _, l := range m.leases {
+		bytes += storageBytes(l)
+	}
+	for _, l := range m.saved {
+		bytes += storageBytes(l)
+	}
+	for key := range m.reserved {
+		bytes += 128 + 2*len(key)
+	}
+	for key := range m.suppressed {
+		bytes += 128 + 2*len(key)
+	}
+	return bytes
+}
+func (m *Manager) transientBytesLocked() int {
+	if m.transientCached {
+		return m.transientRetainedBytes + m.inFlightBytes
+	}
+	bytes := 0
+	for _, event := range m.events {
+		bytes += storageBytes(pendingEvent{*event, event.originalMetadata})
+	}
+	for _, d := range m.decisions {
+		bytes += storageBytes(d)
+	}
+	for _, l := range m.history {
+		bytes += storageBytes(l)
+	}
+	for key := range m.cooldown {
+		bytes += 128 + 2*len(key)
+	}
+	bytes += len(m.runs) * 32
+	m.transientRetainedBytes = bytes
+	m.transientCached = true
+	return bytes + m.inFlightBytes
+}
+func shortFailure(err error) string {
+	text := err.Error()
+	if len(text) > 2048 {
+		return text[:2048]
+	}
+	return text
+}
+func compactLease(l Lease) Lease {
+	l.Domains = nil
+	l.ObservedDomain = ""
+	l.Reason = ""
+	l.OriginSourcePort = 0
+	if l.Failure != nil {
+		l.Failure = &Failure{SourceID: l.Failure.SourceID}
+	}
+	if l.PersistentIP {
+		l.DNSSet = nil
+	}
+	l.NewError = false
+	l.ErrorPort = 0
+	return l
+}
+func (m *Manager) essentialRoomLocked(extra int) bool {
+	if extra <= 0 {
+		return true
+	}
+	if m.essentialBytesLocked()+extra <= m.memoryLimit()/2 {
+		return true
+	}
+	m.cleanupLocked(time.Now(), true)
+	ok := m.essentialBytesLocked()+extra <= m.memoryLimit()/2
+	if !ok {
+		m.RegistryOverflow++
+	}
+	return ok
+}
+func (m *Manager) grantRoomLocked(l Lease) bool {
+	extra := storageBytes(compactLease(l)) + 128 + 2*len(m.key(leaseQuery(l)))
+	for _, old := range m.leases {
+		if m.key(leaseQuery(old)) == m.key(leaseQuery(l)) || (m.sources[l.Source].Mode == "web" && sameIPDeviceScope(leaseQuery(old), leaseQuery(l))) {
+			extra -= storageBytes(old) + 128 + 2*len(m.key(leaseQuery(old)))
+		}
+	}
+	return m.essentialRoomLocked(extra)
+}
+func (m *Manager) transientRoomLocked(extra int) bool {
+	if extra <= 0 {
+		return true
+	}
+	if m.transientBytesLocked()+extra <= m.memoryLimit()/2 {
+		return true
+	}
+	m.cleanupLocked(time.Now(), true)
+	ok := m.transientBytesLocked()+extra <= m.memoryLimit()/2
+	if !ok {
+		m.RegistryOverflow++
+	}
+	return ok
+}
+func (m *Manager) cleanupLocked(now time.Time, pressure bool) {
+	m.transientCached = false
+	retention := m.retention()
+	oldEvents := len(m.events)
+	oldDecisions := len(m.decisions)
+	oldCooldown := len(m.cooldown)
+	for key, event := range m.events {
+		active := m.activeQuery != nil && m.key(*m.activeQuery) == m.key(event.Query)
+		if !active && (event.Status == "applied" || event.Status == "suppressed" || now.Sub(event.Updated) > retention) {
+			delete(m.events, key)
+			for id, d := range m.decisions {
+				if d.Failure != nil && d.Failure.ID == event.ID {
+					delete(m.decisions, id)
+				}
+			}
+		}
+	}
+	for id, d := range m.decisions {
+		if !now.Before(d.Deadline) {
+			delete(m.decisions, id)
+		}
+	}
+	cooldownAge := retention
+	if cooldownAge < 5*time.Minute {
+		cooldownAge = 5 * time.Minute
+	}
+	for key, at := range m.cooldown {
+		if now.Sub(at) >= cooldownAge {
+			delete(m.cooldown, key)
+		}
+	}
+	for id, l := range m.leases {
+		if pressure || now.Sub(l.Created) > retention {
+			compact := compactLease(l)
+			if l.NewError && l.Failure != nil && now.Sub(l.Failure.At) < retention {
+				compact.NewError = true
+				compact.ErrorPort = l.ErrorPort
+				compact.Failure = l.Failure
+				compact.Reason = l.Reason
+			}
+			m.leases[id] = compact
+		}
+	}
+	for key, l := range m.saved {
+		if !now.Before(l.Expires) {
+			delete(m.saved, key)
+			delete(m.reserved, key)
+		}
+	}
+	kept := make([]Lease, 0, len(m.history))
+	if !pressure {
+		for _, l := range m.history {
+			if now.Sub(l.Created) < retention {
+				kept = append(kept, l)
+			}
+		}
+	}
+	m.history = kept
+	// Deletion frees payloads; rebuilding sparse maps also releases their tables
+	// to the normal Go collector, without periodic forced GC or system cache drops.
+	if pressure || len(m.events) < oldEvents/2 {
+		fresh := make(map[string]*Event, len(m.events))
+		for k, v := range m.events {
+			fresh[k] = v
+		}
+		m.events = fresh
+	}
+	if pressure || len(m.decisions) < oldDecisions/2 {
+		fresh := make(map[string]Decision, len(m.decisions))
+		for k, v := range m.decisions {
+			fresh[k] = v
+		}
+		m.decisions = fresh
+	}
+	if pressure || len(m.cooldown) < oldCooldown/2 {
+		fresh := make(map[string]time.Time, len(m.cooldown))
+		for k, v := range m.cooldown {
+			fresh[k] = v
+		}
+		m.cooldown = fresh
+	}
+}
