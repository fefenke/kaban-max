diff --git a/common/autoroute/ip_registry.go b/common/autoroute/ip_registry.go
new file mode 100644
index 0000000..466091f
--- /dev/null
+++ b/common/autoroute/ip_registry.go
@@ -0,0 +1,57 @@
+package autoroute
+
+func sameIPScope(a, b Query) bool {
+	return a.Source == b.Source && a.IP == b.IP && a.SourceIP == b.SourceIP && a.Inbound == b.Inbound && a.Port == b.Port
+}
+func scopeMatches(a, b Query) bool {
+	return sameIPScope(a, b) && (a.Domain == "" || a.Domain == b.Domain)
+}
+func leaseQuery(l Lease) Query {
+	return Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}
+}
+
+func (m *Manager) probeKey(q Query) string { q.Domain = ""; return m.key(q) }
+
+// Caller holds m.mu. A blank domain is an IP exclusion, still scoped to the
+// original section, device, inbound and destination port.
+func (m *Manager) deniedScope(q Query) bool {
+	if m.suppressed[m.key(q)] {
+		return true
+	}
+	q.Domain = ""
+	return m.suppressed[m.key(q)]
+}
+
+// Domains are labels collected from actual connections, never reverse DNS.
+func appendDomain(names []string, name string) []string {
+	if name == "" {
+		return names
+	}
+	for _, old := range names {
+		if old == name {
+			return names
+		}
+	}
+	if len(names) < 64 {
+		names = append(names, name)
+	}
+	return names
+}
+
+func (m *Manager) persistentIP(d *Decision) {
+	d.PersistentIP = true
+	for _, event := range m.events {
+		if event.Source == d.Source && event.IP == d.IP {
+			for _, name := range event.Domains {
+				d.Domains = appendDomain(d.Domains, name)
+			}
+			d.Domains = appendDomain(d.Domains, event.ObservedDomain)
+		}
+	}
+	// Exactly one grant for this IP and original device/inbound/port scope.
+	for key, old := range m.leases {
+		if old.Source == d.Source && old.IP == d.IP && old.SourceIP == d.SourceIP && old.Inbound == d.Inbound && old.Port == d.Port {
+			delete(m.leases, key)
+		}
+	}
+}
