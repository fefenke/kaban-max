diff --git a/common/autoroute/checkpoint.go b/common/autoroute/checkpoint.go
new file mode 100644
index 0000000..cdf5fb1
--- /dev/null
+++ b/common/autoroute/checkpoint.go
@@ -0,0 +1,50 @@
+package autoroute
+
+import (
+	"encoding/json"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	"time"
+)
+
+// Private runtime checkpoint: source config can restore pending records across
+// a core restart. Public State never exposes process/client/DNS metadata.
+type pendingEvent struct {
+	Event
+	Metadata *adapter.InboundContext `json:"original_metadata"`
+}
+
+func (m *Manager) checkpoint() []pendingEvent {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	result := []pendingEvent{}
+	for _, event := range m.events {
+		if event.Failure == nil {
+			continue
+		}
+		copy := *event
+		copy.Domains = append([]string(nil), event.Domains...)
+		var metadata *adapter.InboundContext
+		if event.originalMetadata != nil {
+			metadata = snapshotOriginalMetadata(event.originalMetadata)
+		}
+		result = append(result, pendingEvent{copy, metadata})
+	}
+	return result
+}
+func (m *Manager) loadPending(source option.KabanmaxAutoSource) {
+	for _, raw := range source.Pending {
+		var saved pendingEvent
+		if len(m.events) >= 64 || json.Unmarshal(raw, &saved) != nil {
+			continue
+		}
+		e := saved.Event
+		if e.Source != source.Outbound || e.SourceID != source.ID || e.Network != "tcp" || e.ID == "" || e.Failure == nil || e.Failure.ID != e.ID || e.Failure.SourceID != source.ID || e.Failure.At.After(time.Now()) || !registryScope(e.Query) || sourceContext(source, e.Query) != nil || m.protected(e.Query) || m.deniedScope(e.Query) {
+			continue
+		}
+		e.originalMetadata = saved.Metadata
+		e.active = 0
+		e.attempted = false
+		m.events[e.ID] = &e
+	}
+}
