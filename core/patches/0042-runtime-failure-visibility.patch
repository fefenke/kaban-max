diff --git a/protocol/group/fallback_stream_failure.go b/protocol/group/fallback_stream_failure.go
new file mode 100755
index 0000000..ee73378
--- /dev/null
+++ b/protocol/group/fallback_stream_failure.go
@@ -0,0 +1,61 @@
+package group
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"sync"
+	"syscall"
+
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// A completed TCP dial is not a completed TLS/HTTP exchange. Observe late
+// transport failures without changing deadlines or retrying application data.
+type stableFailureConn struct {
+	N.ExtendedConn
+	ctx       context.Context
+	fallback  *Fallback
+	candidate fallbackCandidate
+	once      sync.Once
+}
+
+func (c *stableFailureConn) failure(err error) {
+	if errors.Is(err, syscall.EAGAIN) || errors.Is(err, syscall.EWOULDBLOCK) {
+		return
+	}
+	if err == nil || errors.Is(err, io.EOF) || errors.Is(err, net.ErrClosed) || errors.Is(err, context.Canceled) || c.ctx.Err() != nil || c.fallback.ctx.Err() != nil {
+		return
+	}
+	c.once.Do(func() { c.fallback.recordDialFailure(c.candidate, err) })
+}
+func (c *stableFailureConn) Read(p []byte) (int, error) {
+	n, err := c.ExtendedConn.Read(p)
+	c.failure(err)
+	return n, err
+}
+func (c *stableFailureConn) Write(p []byte) (int, error) {
+	n, err := c.ExtendedConn.Write(p)
+	c.failure(err)
+	return n, err
+}
+func (c *stableFailureConn) ReadBuffer(b *buf.Buffer) error {
+	err := c.ExtendedConn.ReadBuffer(b)
+	c.failure(err)
+	return err
+}
+func (c *stableFailureConn) WriteBuffer(b *buf.Buffer) error {
+	err := c.ExtendedConn.WriteBuffer(b)
+	c.failure(err)
+	return err
+}
+func (c *stableFailureConn) Upstream() any           { return c.ExtendedConn }
+func (c *stableFailureConn) ReaderReplaceable() bool { return false }
+func (c *stableFailureConn) WriterReplaceable() bool { return false }
+
+func (s *Fallback) observeStableFailures(ctx context.Context, conn net.Conn, candidate fallbackCandidate) net.Conn {
+	return &stableFailureConn{ExtendedConn: bufio.NewExtendedConn(conn), ctx: ctx, fallback: s, candidate: candidate}
+}
