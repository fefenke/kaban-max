+// The network manager sees the WARP wrapper, not its nested WireGuard endpoint.
+// Forward resets so the transport can replace UDP sockets after a WAN change.
+// Registration is asynchronous: never wait for it from the network manager.
+func (w *Endpoint) InterfaceUpdated(ctx context.Context) {
+	w.access.RLock()
+	transport := w.endpoint
+	w.access.RUnlock()
+	if listener, ok := transport.(adapter.InterfaceUpdateListener); ok {
+		listener.InterfaceUpdated(ctx)
+	}
+}
