diff --git a/common/autoroute/registry.go b/common/autoroute/registry.go
new file mode 100755
index 0000000..27f0525
--- /dev/null
+++ b/common/autoroute/registry.go
@@ -0,0 +1,154 @@
+package autoroute
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/sagernet/sing-box/option"
+	"net/netip"
+	"time"
+)
+
+func (m *Manager) loadSaved(s option.KabanmaxAutoSource) {
+	now := time.Now()
+	for _, raw := range s.Saved {
+		var l Lease
+		if json.Unmarshal(raw, &l) != nil || l.Owner != "auto-routing" || l.SourceID != s.ID || l.Source != s.Outbound || !l.DomainKnown || l.Domain == "" || l.Created.After(now) || !now.Before(l.Expires) || l.Expires.After(l.Created.Add(15*time.Minute)) {
+			continue
+		}
+		q := Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}
+		if !registryScope(q) || len(m.saved) >= 64 {
+			continue
+		}
+		m.saved[m.key(q)] = l // Intent only: never insert into leases here.
+	}
+}
+
+func registryScope(q Query) bool {
+	_, ipErr := netip.ParseAddr(q.IP)
+	_, sourceErr := netip.ParseAddr(q.SourceIP)
+	return ipErr == nil && sourceErr == nil && q.Port > 0 && (q.Inbound == "tproxy-in" || q.Inbound == "tproxy6-in" || q.Inbound == "system-in" || q.Inbound == "system6-in")
+}
+
+// A restored approval needs a newly attested flow AND fresh strict application
+// evidence. Web/IP-only decisions never inherit automatic permission from disk.
+func (m *Manager) restoreDecision(d *Decision) bool {
+	if !d.AutoApplyEligible || !d.ApplyAllowed || !d.DomainKnown || d.Status != "proposed" {
+		return false
+	}
+	q := Query{Source: d.Source, IP: d.IP, Domain: d.Domain, SourceIP: d.SourceIP, SourcePort: d.OriginSourcePort, Inbound: d.Inbound, Port: d.Port}
+	m.mu.Lock()
+	saved, ok := m.saved[m.key(q)]
+	m.mu.Unlock()
+	if !ok || saved.Target != d.Target || !time.Now().Before(saved.Expires) || !m.flowKnown(q) {
+		return false
+	}
+	if saved.Expires.Before(d.Deadline) {
+		d.Deadline = saved.Expires
+		d.Expires = saved.Expires
+	}
+	return true
+}
+
+// Exclusion is not an application decision. An attributed IP-only event may be
+// excluded, but its source/device/inbound/port scope must still be exact.
+func (m *Manager) registryExclude(sourceID, id string) (any, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	var q Query
+	found := false
+	for _, e := range m.events {
+		if e.ID == id {
+			q = e.Query
+			found = e.SourceID == sourceID
+			break
+		}
+	}
+	if d, ok := m.decisions[id]; ok {
+		q = Query{Source: d.Source, IP: d.IP, Domain: d.Domain, SourceIP: d.SourceIP, Inbound: d.Inbound, Port: d.Port}
+		found = d.SourceID == sourceID
+	}
+	if l, ok := m.leases[id]; ok {
+		q = Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}
+		found = l.SourceID == sourceID
+	}
+	if !found || m.sources[q.Source].ID != sourceID || !registryScope(q) {
+		return nil, errors.New("source_or_record_not_found")
+	}
+	key := m.key(q)
+	if !m.suppressed[key] && len(m.suppressed) >= 64 {
+		return nil, errors.New("suppression_budget")
+	}
+	m.registryAdvance(key)
+	m.suppressed[key] = true
+	for keyID, l := range m.leases {
+		if m.key(Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}) == key {
+			l.Status = "removed"
+			m.record(l)
+			delete(m.leases, keyID)
+		}
+	}
+	for keyID, d := range m.decisions {
+		if d.Scope == key {
+			delete(m.decisions, keyID)
+		}
+	}
+	delete(m.saved, key)
+	for _, e := range m.events {
+		if m.key(e.Query) == key {
+			e.Status = "suppressed"
+			e.attempted = true
+		}
+	}
+	return map[string]any{"source_id": sourceID, "suppressed": []string{key}}, nil
+}
+
+func (m *Manager) registryReset(sourceID, key string) (any, error) {
+	if _, err := m.registryQuery(sourceID, key); err != nil {
+		return nil, err
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	found := false
+	for _, s := range m.sources {
+		if s.ID == sourceID {
+			found = true
+		}
+	}
+	if !found {
+		return nil, errors.New("source_not_found")
+	}
+	m.registryAdvance(key)
+	delete(m.suppressed, key)
+	delete(m.saved, key)
+	for id, d := range m.decisions {
+		if d.Scope == key {
+			delete(m.decisions, id)
+		}
+	}
+	for _, e := range m.events {
+		if m.key(e.Query) == key {
+			e.attempted = false
+			e.Status = "observing"
+			e.lastJob = time.Time{}
+		}
+	}
+	return map[string]any{"source_id": sourceID, "reset_scope": key}, nil
+}
+
+func (m *Manager) registryWithdraw(sourceID, id string) (any, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	l, ok := m.leases[id]
+	if !ok {
+		return nil, errors.New("lease_not_found")
+	}
+	if l.SourceID != sourceID {
+		return nil, errors.New("source_not_found")
+	}
+	m.registryAdvance(m.key(Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}))
+	delete(m.leases, id)
+	l.Status = "removed"
+	m.record(l)
+	delete(m.saved, m.key(Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}))
+	return map[string]any{"source_id": sourceID}, nil
+}
