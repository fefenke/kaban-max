new file mode 100755
index 0000000..b3fc0ae
--- /dev/null
+++ b/common/autoroute/scope.go
@@ -0,0 +1,129 @@
+package autoroute
+
+import (
+	"encoding/json"
+	"errors"
+)
+
+// Retire in-flight work without invalidating already verified decisions for a
+// different exact scope. Apply still rechecks DNS, policy and expiry itself.
+func (m *Manager) registryAdvance(key string) {
+	previous := m.generation
+	m.generation++
+	for id, d := range m.decisions {
+		if d.Scope != key && d.Generation == previous {
+			d.Generation = m.generation
+			m.decisions[id] = d
+		}
+	}
+	if m.activeQuery != nil && m.key(*m.activeQuery) == key {
+		if m.activeCancel != nil {
+			m.activeCancel()
+		}
+		if m.batchCancel != nil {
+			m.batchCancel()
+		}
+	}
+}
+
+func (m *Manager) registryQuery(sourceID, key string) (Query, error) {
+	var parts []json.RawMessage
+	var owner string
+	var q Query
+	if len(key) > 1024 || json.Unmarshal([]byte(key), &parts) != nil || len(parts) != 6 || json.Unmarshal(parts[0], &owner) != nil || owner != sourceID {
+		return q, errors.New("invalid_scope")
+	}
+	if json.Unmarshal(parts[1], &q.IP) != nil || json.Unmarshal(parts[2], &q.Domain) != nil || json.Unmarshal(parts[3], &q.SourceIP) != nil || json.Unmarshal(parts[4], &q.Inbound) != nil || json.Unmarshal(parts[5], &q.Port) != nil || !registryScope(q) {
+		return q, errors.New("invalid_scope")
+	}
+	for tag, s := range m.sources {
+		if s.ID == sourceID {
+			q.Source = tag
+			break
+		}
+	}
+	if q.Source == "" || m.key(q) != key {
+		return q, errors.New("source_or_scope_not_found")
+	}
+	return q, nil
+}
+
+func (m *Manager) registrySuppress(sourceID, key string) (any, error) {
+	q, err := m.registryQuery(sourceID, key)
+	if err != nil {
+		return nil, err
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if !m.suppressed[key] && len(m.suppressed) >= 64 {
+		return nil, errors.New("suppression_budget")
+	}
+	m.registryAdvance(key)
+	m.suppressed[key] = true
+	delete(m.saved, key)
+	for id, l := range m.leases {
+		if m.key(Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}) == key {
+			delete(m.leases, id)
+			l.Status = "removed"
+			m.record(l)
+		}
+	}
+	for id, d := range m.decisions {
+		if d.Scope == key {
+			delete(m.decisions, id)
+		}
+	}
+	for _, e := range m.events {
+		if m.key(e.Query) == key {
+			e.Status = "suppressed"
+			e.attempted = true
+		}
+	}
+	_ = q
+	return map[string]any{"source_id": sourceID, "suppressed": []string{key}}, nil
+}
+
+func (m *Manager) registryRevokeBudget(key string) bool {
+	keys := map[string]bool{}
+	for k := range m.suppressed {
+		keys[k] = true
+	}
+	add := func(l Lease) {
+		keys[m.key(Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port})] = true
+	}
+	for id, l := range m.leases {
+		if id == key || l.Source == key {
+			add(l)
+		}
+	}
+	for id, d := range m.decisions {
+		if id == key || d.Source == key {
+			keys[d.Scope] = true
+		}
+	}
+	for _, l := range m.history {
+		if l.ID == key || l.Source == key {
+			add(l)
+		}
+	}
+	if m.activeQuery != nil && m.activeQuery.Source == key && registryScope(*m.activeQuery) {
+		keys[m.key(*m.activeQuery)] = true
+	}
+	return len(keys) <= 64
+}
+
+func (m *Manager) registryRelease(sourceID, key string) (any, error) {
+	if _, err := m.registryQuery(sourceID, key); err != nil {
+		return nil, err
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, l := range m.leases {
+		if m.key(Query{Source: l.Source, IP: l.IP, Domain: l.Domain, SourceIP: l.SourceIP, Inbound: l.Inbound, Port: l.Port}) == key {
+			return nil, errors.New("active_scope_cannot_release_slot")
+		}
+	}
+	delete(m.reserved, key)
+	delete(m.saved, key)
+	return map[string]any{"source_id": sourceID}, nil
+}
