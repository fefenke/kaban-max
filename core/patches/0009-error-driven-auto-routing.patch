new file mode 100755
index 0000000..4a34fa9
--- /dev/null
+++ b/common/autoroute/failure.go
@@ -0,0 +1,79 @@
+package autoroute
+
+import (
+	"context"
+	"errors"
+	E "github.com/sagernet/sing/common/exceptions"
+	"io"
+	"net"
+	"strings"
+	"time"
+)
+
+// Failure is created only when the original flow emits an actual error log.
+// A byte counter stall, DNS observation or a guessed source is never evidence.
+type Failure struct {
+	ID       string    `json:"id"`
+	SourceID string    `json:"source_id"`
+	Message  string    `json:"message"`
+	At       time.Time `json:"at"`
+}
+
+func connectionFailure(err error) bool {
+	if errors.Is(err, context.DeadlineExceeded) {
+		return true
+	}
+	if err == nil || errors.Is(err, io.EOF) || errors.Is(err, net.ErrClosed) || E.IsClosedOrCanceled(err) {
+		return false
+	}
+	for _, marker := range []string{"NO_ERROR", "CANCEL", "body closed"} {
+		if strings.Contains(err.Error(), marker) {
+			return false
+		}
+	}
+	return true
+}
+
+func (m *Manager) loggedFailure(q Query) *Failure {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, event := range m.events {
+		if event.Network == "tcp" && event.Query == q && event.Failure != nil && time.Since(event.Failure.At) <= time.Hour {
+			copy := *event.Failure
+			return &copy
+		}
+	}
+	return nil
+}
+
+// Dismiss removes the current failure/decision, without a permanent exclusion.
+func (m *Manager) registryDismiss(sourceID, id string) (any, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	var q Query
+	found := false
+	if event, ok := m.events[id]; ok && event.SourceID == sourceID && event.Failure != nil {
+		q = event.Query
+		found = true
+	}
+	if decision, ok := m.decisions[id]; ok && decision.SourceID == sourceID && decision.Failure != nil {
+		q = Query{Source: decision.Source, IP: decision.IP, Domain: decision.Domain, SourceIP: decision.SourceIP, SourcePort: decision.OriginSourcePort, Inbound: decision.Inbound, Port: decision.Port}
+		found = true
+	}
+	if !found || m.sources[q.Source].ID != sourceID {
+		return nil, errors.New("source_or_record_not_found")
+	}
+	scope := m.key(q)
+	m.registryAdvance(scope)
+	for key, event := range m.events {
+		if m.key(event.Query) == scope {
+			delete(m.events, key)
+		}
+	}
+	for key, decision := range m.decisions {
+		if decision.Scope == scope {
+			delete(m.decisions, key)
+		}
+	}
+	return map[string]any{"source_id": sourceID}, nil
+}
