diff --git a/common/autoroute/protocol_risk.go b/common/autoroute/protocol_risk.go
new file mode 100755
index 0000000..b8109ef
--- /dev/null
+++ b/common/autoroute/protocol_risk.go
@@ -0,0 +1,38 @@
+package autoroute
+
+import (
+	"context"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"net/netip"
+)
+
+// Explicit TCP-only risk opt-in. This sends no application bytes and must
+// never be labelled verified TLS, HTTP, DPI evidence or UDP reachability.
+func (m *Manager) unconfirmedTCPAttempt(ctx context.Context, q Query, s option.KabanmaxAutoSource, tag string, a Attempt) Attempt {
+	a.Method = "TCP"
+	outbound, err := m.target(s, tag)
+	if err != nil {
+		a.Status = "blocked_by_policy"
+		a.Reason = err.Error()
+		return a
+	}
+	ctx, cancel := context.WithTimeout(ctx, webAttemptTimeout(outbound))
+	defer cancel()
+	conn, err := outbound.DialContext(ctx, "tcp", M.Socksaddr{Addr: netip.MustParseAddr(q.IP), Port: q.Port})
+	if err != nil {
+		a.Status = "transport_failure"
+		a.Reason = "tcp_transport_failed"
+		return a
+	}
+	defer conn.Close()
+	if N.NeedHandshakeForWrite(conn) {
+		a.Reason = "tcp_connection_unconfirmed"
+		return a
+	}
+	a.Reachable = true
+	a.Status = "transport_reachable"
+	a.Reason = "protocol_unconfirmed_risk_opt_in"
+	return a
+}
