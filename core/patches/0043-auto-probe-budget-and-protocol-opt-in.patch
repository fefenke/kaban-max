diff --git a/common/autoroute/web_timeout.go b/common/autoroute/web_timeout.go
new file mode 100755
index 0000000..3ff2bf1
--- /dev/null
+++ b/common/autoroute/web_timeout.go
@@ -0,0 +1,28 @@
+package autoroute
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	N "github.com/sagernet/sing/common/network"
+	"time"
+)
+
+// Keep the ordinary allowance for TLS/HTTP after a declared dial budget. A
+// WithTimeout child still obeys the parent job's unchanged sixty-second limit.
+func webAttemptTimeout(outbound adapter.Outbound) time.Duration {
+	const responseBudget = 5 * time.Second
+	for depth := 0; depth < 8 && outbound != nil; depth++ {
+		if limited, ok := outbound.(interface{ KabanmaxProbeDialTimeout() time.Duration }); ok {
+			budget := limited.KabanmaxProbeDialTimeout()
+			if budget >= time.Minute-responseBudget {
+				return time.Minute
+			}
+			return responseBudget + max(0, budget)
+		}
+		group, ok := outbound.(adapter.OutboundGroup)
+		if !ok {
+			break
+		}
+		outbound = group.Selected(N.NetworkTCP)
+	}
+	return responseBudget
+}
