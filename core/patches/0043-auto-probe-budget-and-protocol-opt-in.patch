--- a/protocol/group/fallback.go
+++ b/protocol/group/fallback.go
@@ -1007,3 +1007,17 @@ func (c *fallbackEarlyConn) Upstream() any {
 	defer c.access.Unlock()
 	return c.Conn
 }
+
+// KabanmaxProbeDialTimeout describes bounded TCP candidate attempts, separately
+// from the health-check timeout. It never raises the automatic job's 60s cap.
+func (s *Fallback) KabanmaxProbeDialTimeout() time.Duration {
+	timeout := s.attemptTimeout
+	if timeout <= 0 {
+		timeout = defaultFallbackAttemptTimeout
+	}
+	count := max(1, len(s.candidatesForNetwork(N.NetworkTCP)))
+	if timeout >= time.Minute || time.Duration(count) > time.Minute/timeout {
+		return time.Minute
+	}
+	return timeout * time.Duration(count)
+}
