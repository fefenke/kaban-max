diff --git a/common/autoroute/original_context.go b/common/autoroute/original_context.go
new file mode 100644
index 0000000..b5fc3be
--- /dev/null
+++ b/common/autoroute/original_context.go
@@ -0,0 +1,69 @@
+package autoroute
+
+import (
+	"context"
+	"slices"
+	"time"
+
+	"github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+)
+
+type originalMetadataKey struct{}
+
+// HasOriginalMetadata is set only by guard after resolving a core-owned logged
+// event. A JSON/API query cannot assert that missing metadata is known absent.
+func HasOriginalMetadata(ctx context.Context) bool { return ctx.Value(originalMetadataKey{}) == true }
+
+func snapshotOriginalMetadata(meta *adapter.InboundContext) *adapter.InboundContext {
+	copy := *meta
+	copy.DestinationAddresses = slices.Clone(meta.DestinationAddresses)
+	copy.NetworkType = slices.Clone(meta.NetworkType)
+	copy.FallbackNetworkType = slices.Clone(meta.FallbackNetworkType)
+	copy.SnifferNames = slices.Clone(meta.SnifferNames)
+	copy.SourceMACAddress = slices.Clone(meta.SourceMACAddress)
+	copy.OutboundChain = slices.Clone(meta.OutboundChain)
+	if meta.ProcessInfo != nil {
+		owner := *meta.ProcessInfo
+		owner.AndroidPackageNames = slices.Clone(meta.ProcessInfo.AndroidPackageNames)
+		copy.ProcessInfo = &owner
+	}
+	if meta.DNSResponse != nil {
+		copy.DNSResponse = meta.DNSResponse.Copy()
+	}
+	if meta.NamedDNSResponses != nil {
+		copy.NamedDNSResponses = make(map[string]*dns.Msg, len(meta.NamedDNSResponses))
+		for name, response := range meta.NamedDNSResponses {
+			if response != nil {
+				copy.NamedDNSResponses[name] = response.Copy()
+			}
+		}
+	}
+	copy.ResetRuleCache()
+	return &copy
+}
+
+func (m *Manager) originalForQuery(q Query) *adapter.InboundContext {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, event := range m.events {
+		if event.Query == q && event.Failure != nil && time.Since(event.Failure.At) <= time.Hour && event.originalMetadata != nil {
+			return snapshotOriginalMetadata(event.originalMetadata)
+		}
+	}
+	return nil
+}
+
+func (m *Manager) observedDomain(q Query) string {
+	if q.Domain != "" {
+		return q.Domain
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, event := range m.events {
+		if event.Query == q && event.Failure != nil {
+			return event.ObservedDomain
+		}
+	}
+	return ""
+}
