diff --git a/common/autoroute/quic_transport_probe.go b/common/autoroute/quic_transport_probe.go
new file mode 100644
--- /dev/null
+++ b/common/autoroute/quic_transport_probe.go
@@ -0,0 +1,85 @@
+//go:build with_quic
+
+package autoroute
+
+import (
+	"context"
+	"crypto/tls"
+	"github.com/sagernet/quic-go"
+	"github.com/sagernet/quic-go/qlog"
+	"github.com/sagernet/quic-go/qlogwriter"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// Observe only the type/length of decrypted 1-RTT packets. No frames or payloads
+// are retained or encoded. The transport itself authenticates these packets.
+type quicTransportWitness struct {
+	ready atomic.Bool
+	bytes atomic.Int64
+	done  chan struct{}
+	once  sync.Once
+}
+
+func (w *quicTransportWitness) AddProducer() qlogwriter.Recorder { return w }
+func (w *quicTransportWitness) SupportsSchemas(string) bool      { return true }
+func (w *quicTransportWitness) Close() error                     { return nil }
+func (w *quicTransportWitness) RecordEvent(event qlogwriter.Event) {
+	packet, ok := event.(qlog.PacketReceived)
+	if ok && w.ready.Load() && packet.Header.PacketType == qlog.PacketType1RTT && packet.Raw.Length > 0 {
+		w.bytes.Store(int64(packet.Raw.Length))
+		w.once.Do(func() { close(w.done) })
+	}
+}
+
+func quicTransportAttempt(ctx context.Context, outbound N.Dialer, destination M.Socksaddr, tlsConfig *tls.Config, protocols []string, version uint32, a Attempt) Attempt {
+	a.Method = "QUIC"
+	socket, err := dialPinnedQUICSocket(ctx, outbound, destination)
+	if err != nil {
+		a.Status = "transport_failure"
+		a.Reason = "udp_transport_failed"
+		return a
+	}
+	defer socket.Close()
+	witness := &quicTransportWitness{done: make(chan struct{})}
+	config := &quic.Config{HandshakeIdleTimeout: 5 * time.Second, MaxIdleTimeout: 5 * time.Second, KeepAlivePeriod: 100 * time.Millisecond, InitialPacketSize: 1200, DisablePathMTUDiscovery: true,
+		Tracer: func(context.Context, bool, quic.ConnectionID) qlogwriter.Trace { return witness }}
+	if version == uint32(quic.Version1) || version == uint32(quic.Version2) {
+		config.Versions = []quic.Version{quic.Version(version)}
+	}
+	tlsConfig = tlsConfig.Clone()
+	tlsConfig.NextProtos = append([]string(nil), protocols...)
+	conn, err := quic.Dial(ctx, socket, socket.peer, tlsConfig, config)
+	if err != nil {
+		a.Status = "transport_failure"
+		a.Reason = "quic_handshake_unconfirmed"
+		return a
+	}
+	defer conn.CloseWithError(0, "")
+	state := conn.ConnectionState().TLS
+	a.TLSVerified = len(state.VerifiedChains) > 0
+	a.NegotiatedProtocol = state.NegotiatedProtocol
+	if !a.TLSVerified || state.NegotiatedProtocol == "" {
+		a.Status = "inconclusive"
+		a.Reason = "quic_identity_unconfirmed"
+		return a
+	}
+	witness.ready.Store(true)
+	select {
+	case <-witness.done:
+		a.Reachable = true
+		a.TransportBytes = int(witness.bytes.Load())
+		a.Status = "verified"
+		a.Reason = "authenticated_quic_1rtt_exchange"
+	case <-ctx.Done():
+		a.Status = "transport_failure"
+		a.Reason = "quic_data_exchange_timeout"
+	case <-conn.Context().Done():
+		a.Status = "transport_failure"
+		a.Reason = "quic_closed_without_verified_exchange"
+	}
+	return a
+}
