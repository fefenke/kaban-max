+package autoroute
+
+import (
+	"context"
+	"crypto/tls"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"net"
+	"sync/atomic"
+)
+
+func nonHTTPALPN(protocols []string) bool {
+	if len(protocols) == 0 {
+		return false
+	}
+	for _, p := range protocols {
+		if p == "h2" || p == "http/1.1" || p == "http/1.0" {
+			return false
+		}
+	}
+	return true
+}
+
+type tlsByteCounter struct {
+	net.Conn
+	received atomic.Int64
+	sent     atomic.Int64
+}
+
+func (c *tlsByteCounter) Read(p []byte) (int, error) {
+	n, e := c.Conn.Read(p)
+	c.received.Add(int64(n))
+	return n, e
+}
+func (c *tlsByteCounter) Write(p []byte) (int, error) {
+	n, e := c.Conn.Write(p)
+	c.sent.Add(int64(n))
+	return n, e
+}
+
+// Native TLS protocols cannot be tested with an unrelated HTTP request. Two
+// fresh authenticated handshakes attest server bytes on the recorded path;
+// no application payload or credentials are generated or retained.
+func tlsTransportAttempt(ctx context.Context, outbound N.Dialer, destination M.Socksaddr, config *tls.Config, protocols []string, a Attempt) Attempt {
+	a.Method = "TLS"
+	raw, err := outbound.DialContext(ctx, "tcp", destination)
+	if err != nil {
+		a.Status = "transport_failure"
+		a.Reason = "tcp_transport_failed"
+		return a
+	}
+	defer raw.Close()
+	counted := &tlsByteCounter{Conn: raw}
+	config = config.Clone()
+	config.NextProtos = append([]string(nil), protocols...)
+	conn := tls.Client(counted, config)
+	if err = conn.HandshakeContext(ctx); err != nil {
+		a.Reason = "tls_verification_or_protocol_failed"
+		return a
+	}
+	state := conn.ConnectionState()
+	a.TLSVerified = len(state.VerifiedChains) > 0
+	a.NegotiatedProtocol = state.NegotiatedProtocol
+	a.TransportBytes = int(counted.received.Load())
+	if !a.TLSVerified || a.TransportBytes == 0 || counted.sent.Load() == 0 {
+		a.Reason = "tls_identity_or_exchange_unconfirmed"
+		return a
+	}
+	a.Reachable = true
+	a.Status = "verified"
+	a.Reason = "authenticated_tls_transport"
+	return a
+}
