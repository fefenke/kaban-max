+func boundedALPN(protocols []string) []string {
+	result := make([]string, 0, min(len(protocols), 8))
+	for _, protocol := range protocols {
+		if len(protocol) > 0 && len(protocol) <= 64 {
+			result = append(result, protocol)
+		}
+		if len(result) == 8 {
+			break
+		}
+	}
+	return result
+}
