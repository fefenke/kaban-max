+// Use the same connected UDP path as native QUIC transports. A tunnel's
+// ListenPacket wrapper need not expose the UDP address type quic-go requires.
+// Migration to a different destination is forbidden for an IP-scoped probe.
+type pinnedQUICSocket struct {
+	net.Conn
+	peer *net.UDPAddr
+}
+
+func (c *pinnedQUICSocket) ReadFrom(p []byte) (int, net.Addr, error) {
+	n, e := c.Read(p)
+	return n, c.peer, e
+}
+func (c *pinnedQUICSocket) WriteTo(p []byte, addr net.Addr) (int, error) {
+	if M.SocksaddrFromNet(addr) != M.SocksaddrFromNet(c.peer) {
+		return 0, net.ErrWriteToConnected
+	}
+	return c.Write(p)
+}
+func dialPinnedQUICSocket(ctx context.Context, outbound N.Dialer, destination M.Socksaddr) (*pinnedQUICSocket, error) {
+	conn, err := outbound.DialContext(ctx, "udp", destination)
+	if err != nil {
+		return nil, err
+	}
+	return &pinnedQUICSocket{Conn: conn, peer: &net.UDPAddr{IP: net.IP(destination.Addr.AsSlice()), Port: int(destination.Port)}}, nil
+}
