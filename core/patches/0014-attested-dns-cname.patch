+// DNS identity is attested only by one bounded CNAME path rooted at the
+// requested name. Never import addresses or aliases from another answer owner.
+func kabanmaxDNSIdentity(reply *dns.Msg, name string, qtype uint16) ([]netip.Addr, uint32, error) {
+	reject := errors.New("dns_answer_identity_unconfirmed")
+	if reply == nil || reply.Rcode != dns.RcodeSuccess || (qtype != dns.TypeA && qtype != dns.TypeAAAA) {
+		return nil, 0, reject
+	}
+	canonical := func(name string) string { return strings.ToLower(dns.Fqdn(name)) }
+	aliases := make(map[string]string)
+	ttl := uint32(900)
+	for _, rr := range reply.Answer {
+		header := rr.Header()
+		if header.Rrtype != dns.TypeA && header.Rrtype != dns.TypeAAAA && header.Rrtype != dns.TypeCNAME {
+			continue
+		}
+		if header.Class != dns.ClassINET {
+			return nil, 0, reject
+		}
+		if header.Ttl < ttl {
+			ttl = header.Ttl
+		}
+		if alias, ok := rr.(*dns.CNAME); ok {
+			owner, target := canonical(header.Name), canonical(alias.Target)
+			if _, valid := dns.IsDomainName(owner); !valid {
+				return nil, 0, reject
+			}
+			if _, valid := dns.IsDomainName(target); !valid {
+				return nil, 0, reject
+			}
+			if previous, exists := aliases[owner]; exists && previous != target {
+				return nil, 0, reject
+			}
+			aliases[owner] = target
+		}
+	}
+	terminal := canonical(name)
+	visited := make(map[string]bool)
+	hops := 0
+	for {
+		if visited[terminal] {
+			return nil, 0, reject
+		}
+		visited[terminal] = true
+		target, exists := aliases[terminal]
+		if !exists {
+			break
+		}
+		hops++
+		if hops > 8 {
+			return nil, 0, reject
+		}
+		terminal = target
+	}
+	// Every alias in this answer must belong to the attested path.
+	if hops != len(aliases) {
+		return nil, 0, reject
+	}
+	addresses := []netip.Addr{}
+	for _, rr := range reply.Answer {
+		header := rr.Header()
+		if header.Rrtype != dns.TypeA && header.Rrtype != dns.TypeAAAA {
+			continue
+		}
+		if header.Rrtype != qtype || canonical(header.Name) != terminal {
+			return nil, 0, reject
+		}
+		var address netip.Addr
+		var ok bool
+		switch value := rr.(type) {
+		case *dns.A:
+			address, ok = netip.AddrFromSlice(value.A)
+			if !ok || !address.Unmap().Is4() {
+				return nil, 0, reject
+			}
+		case *dns.AAAA:
+			address, ok = netip.AddrFromSlice(value.AAAA)
+			if !ok || !address.Is6() {
+				return nil, 0, reject
+			}
+		default:
+			return nil, 0, reject
+		}
+		addresses = append(addresses, address.Unmap())
+	}
+	return addresses, ttl, nil
+}
