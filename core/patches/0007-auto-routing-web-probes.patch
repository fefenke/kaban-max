diff --git a/common/autoroute/web.go b/common/autoroute/web.go
new file mode 100755
index 0000000..f220050
--- /dev/null
+++ b/common/autoroute/web.go
@@ -0,0 +1,201 @@
+package autoroute
+
+import (
+	"context"
+	"crypto/tls"
+	"crypto/x509"
+	"errors"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+	"io"
+	"mime"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Ordinary checks attest only a bounded HTTPS response, never DPI or freshness
+// equivalent to the strict nonce contract. They can propose, never auto-apply.
+func (m *Manager) webAttempt(ctx context.Context, q Query, s option.KabanmaxAutoSource, tag string) Attempt {
+	a := Attempt{Outbound: tag, DialIP: q.IP, Status: "inconclusive", At: time.Now(), Hostname: q.Domain, Port: q.Port, Path: s.Path, Method: "GET"}
+	if _, e := m.guard(ctx, q); e != nil {
+		a.Reason = e.Error()
+		return a
+	}
+	outbound, e := m.target(s, tag)
+	if e != nil {
+		a.Status = "blocked_by_policy"
+		a.Reason = e.Error()
+		return a
+	}
+	if marked, ok := outbound.(interface{ KabanmaxRoutingMark() uint32 }); ok {
+		a.RoutingMark = marked.KabanmaxRoutingMark()
+	}
+	ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	dial := func(c context.Context, network, address string) (net.Conn, error) {
+		conn, err := outbound.DialContext(c, "tcp", M.Socksaddr{Addr: netip.MustParseAddr(q.IP), Port: q.Port})
+		if err == nil {
+			a.Reachable = true
+			a.Peer = conn.RemoteAddr().String()
+		}
+		return conn, err
+	}
+	if q.Domain == "" {
+		a.Method = "TCP"
+		a.Path = ""
+		conn, err := dial(ctx, "tcp", "")
+		if err != nil {
+			a.Status = "transport_failure"
+			a.Reason = "tcp_dial_failed_identity_unknown"
+		} else {
+			conn.Close()
+			a.Status = "transport_reachable"
+			a.Reason = "tcp_only_not_application_evidence"
+		}
+		return a
+	}
+	target := url.URL{Scheme: "https", Host: net.JoinHostPort(q.Domain, strconv.Itoa(int(q.Port)))}
+	path, _ := url.Parse(s.Path)
+	target.Path = path.Path
+	query := path.Query()
+	query.Set("__kabanmax_probe", id())
+	target.RawQuery = query.Encode()
+	transport := &http.Transport{Proxy: nil, DisableKeepAlives: true, DisableCompression: true, MaxResponseHeaderBytes: 8192, TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12, ServerName: q.Domain, RootCAs: adapter.RootPoolFromContext(m.ctx)}, DialContext: dial}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	req, err := http.NewRequestWithContext(ctx, "GET", target.String(), nil)
+	if err != nil {
+		a.Reason = "invalid_contract"
+		return a
+	}
+	req.Header.Set("Cache-Control", "no-cache, no-store, max-age=0")
+	req.Header.Set("Pragma", "no-cache")
+	req.Header.Set("Accept", "text/html, application/json, text/plain")
+	response, err := client.Do(req)
+	if err != nil {
+		a.Reason = "tls_or_protocol_unconfirmed"
+		var invalid x509.CertificateInvalidError
+		var unknown x509.UnknownAuthorityError
+		var hostname x509.HostnameError
+		var verification *tls.CertificateVerificationError
+		if errors.As(err, &invalid) || errors.As(err, &unknown) || errors.As(err, &hostname) || errors.As(err, &verification) {
+			a.Reason = "tls_verification_failed"
+			return a
+		}
+		var op *net.OpError
+		if !errors.Is(err, context.Canceled) && (errors.Is(err, context.DeadlineExceeded) || errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.As(err, &op)) {
+			a.Status = "transport_failure"
+			a.Reason = "transport_failure_not_dpi_proof"
+		}
+		return a
+	}
+	defer response.Body.Close()
+	a.HTTPStatus = response.StatusCode
+	a.TLSVerified = response.TLS != nil && len(response.TLS.VerifiedChains) > 0
+	a.ContentType, _, _ = mime.ParseMediaType(response.Header.Get("Content-Type"))
+	if !a.TLSVerified {
+		a.Reason = "tls_verification_failed"
+		return a
+	}
+	switch {
+	case a.HTTPStatus >= 300 && a.HTTPStatus < 400:
+		a.Reason = "redirect"
+	case a.HTTPStatus == 401:
+		a.Reason = "authentication_required"
+	case a.HTTPStatus == 403:
+		a.Reason = "access_denied"
+	case a.HTTPStatus == 429:
+		a.Reason = "rate_limited"
+	case a.HTTPStatus == 405:
+		a.Reason = "method_unsupported"
+	case a.HTTPStatus >= 500:
+		a.Reason = "server_error"
+	case a.HTTPStatus != s.Status:
+		a.Reason = "unexpected_http_status"
+	}
+	if a.Reason != "" {
+		return a
+	}
+	body, err := io.ReadAll(io.LimitReader(response.Body, 4096))
+	a.BodyBytes = len(body)
+	if err != nil {
+		a.Reason = "body_read_error"
+		var failure *net.OpError
+		if !errors.Is(err, context.Canceled) && (errors.Is(err, context.DeadlineExceeded) || errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.As(err, &failure)) {
+			a.Status = "transport_failure"
+			a.Reason = "body_transport_failure_not_dpi_proof"
+		}
+		return a
+	}
+	lower := strings.ToLower(string(body))
+	for _, marker := range []string{"captcha", "cf-chl-", "verify you are human", "just a moment", "access denied", "bot verification"} {
+		if strings.Contains(lower, marker) {
+			a.Reason = "anti_bot"
+			return a
+		}
+	}
+	if age := response.Header.Get("Age"); age != "" && age != "0" {
+		a.Reason = "cached_response"
+		return a
+	}
+	if response.Header.Get("Content-Encoding") != "" && response.Header.Get("Content-Encoding") != "identity" {
+		a.Reason = "encoded_body_unconfirmed"
+		return a
+	}
+	if len(strings.TrimSpace(string(body))) < 32 || (a.ContentType != "text/html" && a.ContentType != "application/json" && a.ContentType != "text/plain") || (s.Prefix != "" && !strings.HasPrefix(string(body), s.Prefix)) {
+		a.Reason = "content_contract_unconfirmed"
+		return a
+	}
+	a.Status = "verified"
+	a.Reason = "bounded_https_content_freshness_unproven"
+	return a
+}
+
+func (m *Manager) flowKnown(q Query) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, e := range m.events {
+		if e.Network == "tcp" && e.Query == q && time.Since(e.Updated) <= time.Hour {
+			return true
+		}
+	}
+	return false
+}
+
+type observationKey struct{}
+type observation struct {
+	manager *Manager
+	event   *Event
+}
+
+func BindObservation(ctx context.Context, m *Manager, e *Event) context.Context {
+	if e == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, observationKey{}, observation{m, e})
+}
+
+// Called only for the actual routed connection's selected direct Zapret dial,
+// not for a DNS lookup, probe, sibling connection or alternative tunnel.
+func ReportDial(ctx context.Context, conn net.Conn, err error) {
+	item, ok := ctx.Value(observationKey{}).(observation)
+	if !ok || err != nil || conn == nil {
+		return
+	}
+	endpoint, e := netip.ParseAddrPort(conn.RemoteAddr().String())
+	if e != nil {
+		return
+	}
+	item.manager.mu.Lock()
+	defer item.manager.mu.Unlock()
+	if item.event.routedLease != "" || endpoint.Port() != item.event.Port {
+		return
+	}
+	item.event.IP = endpoint.Addr().Unmap().String()
+}
