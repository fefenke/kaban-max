 func connectionFailure(err error) bool {
+	// Readiness notifications are not evidence that a route has failed.
+	// Check before net.Error.Timeout: Unix EAGAIN also reports Timeout().
+	if errors.Is(err, syscall.EAGAIN) || errors.Is(err, syscall.EWOULDBLOCK) {
+		return false
+	}
 	if errors.Is(err, context.DeadlineExceeded) {
 		return true
 	}
