+package subscription
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestChrome155FingerprintSurvivesSubscriptionParsing(t *testing.T) {
+	for _, reality := range []bool{false, true} {
+		for _, name := range []string{"chrome_155", " Chrome_155 "} {
+			options, err := UTLSFingerprint(name, "chrome", reality)
+			require.NoError(t, err)
+			require.NotNil(t, options)
+			require.True(t, options.Enabled)
+			require.Equal(t, "chrome_155", options.Fingerprint)
+		}
+		options, err := UTLSFingerprint("", "chrome", reality)
+		require.NoError(t, err)
+		require.Equal(t, "chrome", options.Fingerprint)
+	}
+}
