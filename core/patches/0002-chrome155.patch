+func TestParserFingerprintOverride(t *testing.T) {
+	uri := realityTestLink + "&fp=firefox#Same"
+	for _, fingerprint := range []string{"", " Chrome_155 "} {
+		r := &captureRegistry{}
+		ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), r)
+		_, err := NewOutbound(ctx, nil, nil, "test", option.ParserOutboundOptions{Link: uri, TLSFingerprint: fingerprint})
+		if err != nil {
+			t.Fatal(err)
+		}
+		tls := r.options.(option.OutboundTLSOptionsWrapper).TakeOutboundTLSOptions()
+		expected := "firefox"
+		if fingerprint != "" {
+			expected = "chrome_155"
+		}
+		if tls.UTLS == nil || tls.UTLS.Fingerprint != expected || tls.ServerName != "example.com" || tls.Reality == nil {
+			t.Fatalf("override lost parsed TLS fields: %+v", tls)
+		}
+	}
+}
+
+func TestParserRejectsUnsupportedFingerprintOverride(t *testing.T) {
+	for _, uri := range []string{"socks://example.com:1080", "vless://00000000-0000-0000-0000-000000000001@example.com:443?security=none", "vless://00000000-0000-0000-0000-000000000001@example.com:443?security=tls&type=xhttp&alpn=h3", "hysteria2://password@example.com:443"} {
+		r := &captureRegistry{}
+		ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), r)
+		if _, err := NewOutbound(ctx, nil, nil, "test", option.ParserOutboundOptions{Link: uri, TLSFingerprint: "chrome_155"}); err == nil || r.options != nil {
+			t.Fatalf("accepted unsupported TLS override on %s", uri)
+		}
+	}
+	for _, fp := range []string{"unknown", "none", "unsafe"} {
+		r := &captureRegistry{}
+		ctx := service.ContextWith[adapter.OutboundRegistry](context.Background(), r)
+		if _, err := NewOutbound(ctx, nil, nil, "test", option.ParserOutboundOptions{Link: realityTestLink, TLSFingerprint: fp}); err == nil {
+			t.Fatalf("accepted unsupported fingerprint %s", fp)
+		}
+	}
+}
