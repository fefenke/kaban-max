index 0000000..2253dfa
--- /dev/null
+++ b/common/tls/chrome155_test.go
@@ -0,0 +1,151 @@
+//go:build with_utls
+
+package tls
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"reflect"
+	"testing"
+	"time"
+
+	utls "github.com/metacubex/utls"
+	"github.com/sagernet/sing-box/option"
+	"github.com/stretchr/testify/require"
+)
+
+func TestChrome155IsExplicitAndChromeStays133(t *testing.T) {
+	for _, name := range []string{"", "chrome", "chrome_psk"} {
+		id, err := uTLSClientHelloID(name)
+		require.NoError(t, err)
+		require.Equal(t, "133", id.Version, name)
+	}
+	id, err := uTLSClientHelloID("chrome_155")
+	require.NoError(t, err)
+	require.Equal(t, "Chrome", id.Client)
+	require.Equal(t, "155", id.Version)
+	field, ok := reflect.TypeFor[option.OutboundUTLSOptions]().FieldByName("Fingerprint")
+	require.True(t, ok)
+	require.Contains(t, field.Tag.Get("enum"), "chrome_155")
+}
+
+func TestChrome155RealityHelloHonorsHybridAndRecordOptions(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		hybrid  bool
+		records bool
+	}{
+		{"default", true, false},
+		{"record fragments", true, true},
+		{"explicit classical", false, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			options := realityOptionsForTest("chrome_155", true)
+			options.Reality.SupportX25519MLKEM768 = &test.hybrid
+			options.RecordFragment = test.records
+			logger, _ := newWarnLogger(t)
+			config, err := NewClient(context.Background(), logger, "example.org", options)
+			require.NoError(t, err)
+			client, server := net.Pipe()
+			defer client.Close()
+			defer server.Close()
+			require.NoError(t, server.SetReadDeadline(time.Now().Add(5*time.Second)))
+			done := make(chan error, 1)
+			go func() {
+				_, err := ClientHandshake(context.Background(), client, config)
+				done <- err
+			}()
+			var raw []byte
+			var count int
+			for {
+				header := make([]byte, 5)
+				_, err = io.ReadFull(server, header)
+				require.NoError(t, err)
+				require.Equal(t, byte(22), header[0])
+				payload := make([]byte, binary.BigEndian.Uint16(header[3:]))
+				_, err = io.ReadFull(server, payload)
+				require.NoError(t, err)
+				raw = append(raw, payload...)
+				count++
+				if len(raw) >= 4 && len(raw) == 4+(int(raw[1])<<16|int(raw[2])<<8|int(raw[3])) {
+					break
+				}
+			}
+			server.Close()
+			require.Error(t, <-done, "the capture pipe never supplies a server handshake")
+			wantRecords := 1
+			if test.records {
+				wantRecords = 2
+			}
+			require.Equal(t, wantRecords, count)
+			require.NotEmpty(t, chrome155Extension(t, raw, 0xca34))
+			shares := chrome155Extension(t, raw, 51)[2:]
+			var groups []uint16
+			for len(shares) >= 4 {
+				groups = append(groups, binary.BigEndian.Uint16(shares))
+				length := int(binary.BigEndian.Uint16(shares[2:]))
+				require.GreaterOrEqual(t, len(shares), length+4)
+				shares = shares[length+4:]
+			}
+			require.Contains(t, groups, uint16(utls.X25519))
+			if test.hybrid {
+				require.Contains(t, groups, uint16(utls.X25519MLKEM768))
+			} else {
+				require.NotContains(t, groups, uint16(utls.X25519MLKEM768))
+			}
+		})
+	}
+}
+
+// Parse the bytes emitted by our specification path, not just a preset's ID.
+func chrome155Extension(t *testing.T, raw []byte, wanted uint16) []byte {
+	t.Helper()
+	require.GreaterOrEqual(t, len(raw), 39)
+	pos := 4 + 2 + 32
+	pos += 1 + int(raw[pos])
+	require.GreaterOrEqual(t, len(raw), pos+2)
+	pos += 2 + int(binary.BigEndian.Uint16(raw[pos:]))
+	require.Greater(t, len(raw), pos)
+	pos += 1 + int(raw[pos])
+	require.GreaterOrEqual(t, len(raw), pos+2)
+	end := pos + 2 + int(binary.BigEndian.Uint16(raw[pos:]))
+	pos += 2
+	require.LessOrEqual(t, end, len(raw))
+	for pos+4 <= end {
+		kind := binary.BigEndian.Uint16(raw[pos:])
+		size := int(binary.BigEndian.Uint16(raw[pos+2:]))
+		pos += 4
+		require.LessOrEqual(t, pos+size, end)
+		if kind == wanted {
+			return raw[pos : pos+size]
+		}
+		pos += size
+	}
+	t.Fatalf("ClientHello has no extension %#x", wanted)
+	return nil
+}
+
+func TestChrome155CarriesActualNewWireCapabilities(t *testing.T) {
+	conn := buildClientHello(t, "chrome_155")
+	raw := conn.HandshakeState.Hello.Raw
+	signatures := chrome155Extension(t, raw, 13)
+	require.GreaterOrEqual(t, len(signatures), 10)
+	grease := binary.BigEndian.Uint16(signatures[2:])
+	require.Equal(t, uint16(0x0a0a), grease&0x0f0f)
+	require.Equal(t, byte(grease), byte(grease>>8))
+	for i, want := range []uint16{0x0904, 0x0905, 0x0906} {
+		require.Equal(t, want, binary.BigEndian.Uint16(signatures[4+2*i:]))
+	}
+	anchors := chrome155Extension(t, raw, 0xca34)
+	require.NotEmpty(t, anchors)
+	shares := clientHelloKeyShares(t, conn)
+	hybrid, hybridCount := keyShareIndex(shares, utls.X25519MLKEM768)
+	classical, classicalCount := keyShareIndex(shares, utls.X25519)
+	require.Equal(t, 1, hybridCount)
+	require.Equal(t, 1, classicalCount)
+	require.Less(t, hybrid, classical)
+	require.Len(t, shares[hybrid].Data, 1216)
+	require.Len(t, shares[classical].Data, 32)
+}
